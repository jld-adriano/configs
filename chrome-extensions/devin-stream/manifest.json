{
  "manifest_version": 3,
  "name": "Devin Stream",
  "version": "0.1",
  "description": "Captures live session data from logged-in app.devin.ai tabs (network stream + IndexedDB/localStorage discovery) and ships it to a local sink.",
  "permissions": ["storage", "scripting", "alarms", "tabs"],
  "host_permissions": ["https://app.devin.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.devin.ai/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.devin.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
