{
  "manifest_version": 3,
  "name": "Window Colors",
  "version": "1.1",
  "description": "Colored tab badges with centrally-assigned colors, plus an 'awaiting instructions' border",
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
