#!/bin/bash

# SketchyBar config for AeroSpace monitor/workspace display
# Shows monitor number and current workspace on each display

PLUGIN_DIR="$CONFIG_DIR/plugins"
BAR="/run/current-system/sw/bin/sketchybar"

# Get number of displays
DISPLAY_COUNT=$(/run/current-system/sw/bin/aerospace list-monitors 2>/dev/null | wc -l | tr -d ' ')
[ -z "$DISPLAY_COUNT" ] || [ "$DISPLAY_COUNT" -eq 0 ] && DISPLAY_COUNT=1

##### Bar Appearance #####
$BAR --bar \
  height=28 \
  blur_radius=0 \
  position=top \
  sticky=on \
  topmost=on \
  padding_left=700 \
  padding_right=10 \
  color=0x00000000 \
  display=all

##### Defaults #####
$BAR --default \
  icon.font="SF Pro:Bold:14.0" \
  icon.color=0xffffffff \
  label.font="SF Pro:Bold:14.0" \
  label.color=0xffffffff \
  padding_left=5 \
  padding_right=5

##### Create one item per display #####
for ((i=1; i<=DISPLAY_COUNT; i++)); do
  $BAR --add item monitor_info_$i left \
    --set monitor_info_$i \
      script="MONITOR_NUM=$i $PLUGIN_DIR/monitor_info.sh" \
      update_freq=1 \
      icon.drawing=off \
      associated_display=$i \
    --subscribe monitor_info_$i space_change display_change front_app_switched
done

##### Force initial update #####
$BAR --update
