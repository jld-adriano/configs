#!/usr/bin/env python3
"""Atomically restart Google Chrome, preserving the window layout.

Recovery ritual for when Chrome's memory is beyond saving:
  1. one confirmation dialog up front (Cancel aborts silently)
  2. lock the current layout via aero-layout-lock (no screenshots,
     labelled "chrome-restart") — the snapshot captures every window's
     tabs, so it's a complete record of what to reopen
  3. quit Chrome gracefully and wait for the process to exit
  4. relaunch Chrome and wait for it to be responsive
  5. reapply the snapshot non-interactively with aero-layout-apply's
     confirm() stubbed to True, so its Chrome-restore step reopens every
     snapshot window (with its tabs) and places it on its workspace

This deliberately does NOT rely on Chrome's native "Continue where you
left off" — our own lock/restore is more reliable and independent of any
Chrome setting. Chrome comes back empty and we rebuild it from the lock.

Progress is reported via notifications at each phase. If Chrome isn't
running at the start, the quit step is skipped (lock + launch + apply
still run).
"""

import datetime
import glob
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import time

SCRIPTS = os.path.dirname(os.path.abspath(__file__))
LOCK = os.path.join(SCRIPTS, "aero-layout-lock")
APPLY = os.path.join(SCRIPTS, "aero-layout-apply")
HISTORY_DIR = os.path.expanduser("~/.local/state/aerospace/history")
LABEL = "chrome-restart"

QUIT_TIMEOUT = 60        # seconds to wait for Chrome to exit
READY_TIMEOUT = 60       # seconds to wait for relaunched Chrome to respond
LOCK_TIMEOUT = 240       # capture_order focuses windows; slow with many


def notify(msg):
    try:
        subprocess.run(
            ["osascript", "-e",
             f'display notification "{msg}" with title "Chrome Restart"'],
            timeout=10,
        )
    except Exception:
        pass


def chrome_running():
    return subprocess.run(
        ["pgrep", "-x", "Google Chrome"], capture_output=True,
    ).returncode == 0


def chrome_window_count():
    """Count Chrome windows via AppleScript; None if unreadable."""
    if not chrome_running():
        return 0
    try:
        out = subprocess.run(
            ["osascript", "-e",
             'tell application "Google Chrome" to count of windows'],
            capture_output=True, text=True, timeout=20,
        ).stdout.strip()
        return int(out)
    except Exception:
        return None


def confirm_restart():
    """One up-front dialog; returns True only if the user picks Restart.

    Uses the System Events + activate pattern that already works from
    AeroSpace keybinds elsewhere in this repo (aero-layout-apply's
    pick_state, aero-layout-lock's confirm_screenshots), plus `giving up
    after` so it can never hang.  Only an explicit Cancel (AppleScript
    error -128) exits silently; a give-up or any other osascript failure
    is surfaced via notification so the keybind is never a silent no-op.
    """
    msg = "Restart Chrome? (locks layout, quits, reopens windows, reapplies)"
    quoted = msg.replace("\\", "\\\\").replace('"', '\\"')
    script = (
        'tell application "System Events"\n'
        '  activate\n'
        f'  display dialog "{quoted}" '
        'with title "Chrome Restart" '
        'buttons {"Cancel", "Restart"} default button "Restart" '
        'cancel button "Cancel" giving up after 60\n'
        'end tell'
    )
    try:
        res = subprocess.run(
            ["osascript", "-e", script],
            capture_output=True, text=True, timeout=90,
        )
    except Exception:
        notify("❌ Confirmation dialog hung — aborting, Chrome untouched")
        return False

    if res.returncode == 0:
        if "gave up:true" in res.stdout:
            notify("Confirmation timed out (60s) — Chrome untouched")
            return False
        return "button returned:Restart" in res.stdout

    # Cancel raises AppleScript error -128 (osascript exits nonzero); that
    # is a deliberate user choice, so stay quiet.  Anything else means the
    # dialog itself failed to display (e.g. missing Automation/TCC grant
    # for the launching process) — say so instead of vanishing.
    if "-128" in res.stderr:
        return False
    err = (res.stderr.strip().splitlines() or ["unknown error"])[-1]
    err = err.replace("\\", "").replace('"', "'")[:140]
    notify(f"❌ Couldn't show confirmation: {err}")
    return False


def lock_layout():
    """Run aero-layout-lock (no screenshots); return the snapshot path."""
    started = time.time()
    env = dict(os.environ)
    env["AERO_LOCK_NO_SHOTS"] = "1"
    env["AERO_LOCK_LABEL"] = LABEL
    res = subprocess.run([LOCK], env=env, timeout=LOCK_TIMEOUT)
    if res.returncode != 0:
        return None

    candidates = glob.glob(
        os.path.join(HISTORY_DIR, f"layout-{LABEL}-*.json"))
    fresh = [p for p in candidates if os.path.getmtime(p) >= started - 5]
    if not fresh:
        return None
    return max(fresh, key=os.path.getmtime)


def quit_chrome():
    """Graceful quit; True once the process is gone (no kill -9 fallback)."""
    subprocess.run(
        ["osascript", "-e", 'tell application "Google Chrome" to quit'],
        capture_output=True, timeout=30,
    )
    deadline = time.time() + QUIT_TIMEOUT
    while time.time() < deadline:
        if not chrome_running():
            return True
        time.sleep(1)
    return not chrome_running()


def wait_for_chrome_ready():
    """Wait until the relaunched Chrome answers AppleScript (it comes up
    empty; our apply step rebuilds the windows). Returns True once ready."""
    deadline = time.time() + READY_TIMEOUT
    while time.time() < deadline:
        time.sleep(2)
        if chrome_running() and chrome_window_count() is not None:
            time.sleep(2)  # small settle so `make new window` is reliable
            return True
    return chrome_running()


def load_apply_module():
    """Import aero-layout-apply (extensionless script) as a module."""
    loader = importlib.machinery.SourceFileLoader("aero_layout_apply", APPLY)
    spec = importlib.util.spec_from_loader("aero_layout_apply", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def main():
    if not confirm_restart():
        return  # cancelled: exit silently

    pre_count = chrome_window_count() or 0
    was_running = chrome_running()

    notify(f"⏳ Locking layout ({pre_count} Chrome windows)…")
    snap_path = lock_layout()
    if snap_path is None:
        notify("❌ Layout lock failed — aborting, Chrome untouched")
        sys.exit(1)

    if was_running:
        notify("⏳ Quitting Chrome…")
        if not quit_chrome():
            notify("❌ Chrome didn't quit within 60s — aborting "
                   "(close blocking dialogs and retry)")
            sys.exit(1)

    notify("⏳ Relaunching Chrome…")
    subprocess.run(["open", "-a", "Google Chrome"], timeout=30)
    if not wait_for_chrome_ready():
        notify("❌ Chrome didn't come back up — aborting before reapply")
        sys.exit(1)

    notify(f"⏳ Reopening {pre_count} windows from the lock…")
    with open(snap_path) as f:
        snap = json.load(f)
    mod = load_apply_module()
    # Chrome relaunched empty, so let apply_snapshot's Chrome-restore step
    # reopen every snapshot window (with its tabs) rather than depending on
    # Chrome's native session restore. confirm() stubbed True = "yes, reopen".
    mod.confirm = lambda msg: True
    stamp = datetime.datetime.now().strftime("%H:%M:%S")
    mod.apply_snapshot(snap, f"chrome-restart {stamp}")

    final = chrome_window_count() or 0
    notify(f"✅ Chrome restarted: {final}/{pre_count} windows reopened "
           "and placed")


if __name__ == "__main__":
    main()
