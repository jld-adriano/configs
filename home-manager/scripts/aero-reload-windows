#!/usr/bin/env python3
"""Reload all Chrome tabs (Slack intentionally untouched).

Reloads window-by-window rather than in one big AppleScript call: with ~90
heavy tabs a single reload loop exceeds a short timeout and aborts before
doing anything, so each window gets its own call and a slow window can't kill
the whole run.

Windows are reloaded in small batches with a pause between them so the heavy
Devin/Capy pages don't all rebuild their heaps at once (a full simultaneous
reload spikes memory hard and can push the machine into swap thrash).

Posts notifications at start/end: under memory pressure Chrome answers Apple
Events very slowly, so a full run can take minutes — without feedback it looks
like the hotkey did nothing.
"""

import subprocess
import time

BATCH_SIZE = 5
BATCH_PAUSE_S = 3
PER_WINDOW_TIMEOUT_S = 10


def osascript(script, timeout=30):
    """Run AppleScript; return stdout, or None if it timed out."""
    try:
        return subprocess.run(
            ["osascript", "-e", script],
            capture_output=True, text=True, timeout=timeout,
        ).stdout.strip()
    except subprocess.TimeoutExpired:
        return None


def notify(msg):
    try:
        subprocess.run(
            ["osascript", "-e",
             f'display notification "{msg}" with title "Chrome Reload"'],
            timeout=10,
        )
    except Exception:
        pass


def main():
    start = time.time()
    count = osascript(
        'tell application "Google Chrome" to count of windows', timeout=15)
    try:
        n = int(count)
    except (TypeError, ValueError):
        notify("Chrome didn't respond (busy/thrashing?) — nothing reloaded")
        print("Could not get window count from Chrome; aborting")
        return

    notify(f"⏳ Reloading tabs in {n} windows ({BATCH_SIZE} per batch)…")

    ok, timed_out = 0, 0
    for i in range(1, n + 1):
        # One call per window; per-window timeout so one heavy window can't
        # starve the rest.
        res = osascript(
            f'tell application "Google Chrome" to reload every tab of window {i}',
            timeout=PER_WINDOW_TIMEOUT_S,
        )
        if res is None:
            timed_out += 1
        else:
            ok += 1
        # Pause between batches (but not after the final window) to let each
        # batch settle before the next starts reloading.
        if i % BATCH_SIZE == 0 and i < n:
            time.sleep(BATCH_PAUSE_S)

    elapsed = int(time.time() - start)
    summary = f"Reloaded {ok}/{n} windows in {elapsed}s"
    if timed_out:
        summary += f" ({timed_out} timed out — Chrome busy)"
    notify(summary)
    print(summary)


if __name__ == "__main__":
    main()
