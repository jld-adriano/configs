#!/usr/bin/env python3
"""Reload all Chrome windows and Slack."""

import subprocess


def run(cmd):
    return subprocess.run(
        cmd, shell=True, capture_output=True, text=True, timeout=15
    ).stdout.strip()


# Reload all Chrome tabs
run("""osascript -e '
tell application "Google Chrome"
    repeat with w in every window
        repeat with t in every tab of w
            tell t to reload
        end repeat
    end repeat
end tell'""")

# Reload Slack
run("osascript -e 'tell application \"Slack\" to activate'")
run("""osascript -e '
tell application "System Events"
    tell process "Slack"
        keystroke "r" using command down
    end tell
end tell'""")

print("Reloaded all Chrome tabs + Slack")
