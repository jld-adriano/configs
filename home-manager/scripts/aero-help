#!/usr/bin/env bash

# AeroSpace Keybindings Help
# Displays keybindings with dynamic workspace layout based on current monitor count

MONITOR_COUNT=$(aerospace list-monitors | wc -l | tr -d ' ')

# Calculate workspace ranges for each VD
VD1_END=$MONITOR_COUNT
VD2_START=$((MONITOR_COUNT + 1))
VD2_END=$((MONITOR_COUNT * 2))
VD3_START=$((MONITOR_COUNT * 2 + 1))
VD3_END=$((MONITOR_COUNT * 3))
VD4_START=$((MONITOR_COUNT * 3 + 1))
VD4_END=$((MONITOR_COUNT * 4))

osascript -e "display dialog \"
═══════════════════════════════════════
       AEROSPACE KEYBINDINGS
═══════════════════════════════════════
       [ $MONITOR_COUNT monitors detected ]

WORKSPACE LAYOUT
  VD1: 1-$VD1_END  |  VD2: $VD2_START-$VD2_END  |  VD3: $VD3_START-$VD3_END  |  VD4: $VD4_START-$VD4_END

VIRTUAL DESKTOPS (all monitors switch)
  alt-1/2/3/4        → Virtual Desktop 1-4

MOVE TO MONITOR (stays in current VD)
  alt-ctrl-shift-1-$MONITOR_COUNT → Move to monitor 1-$MONITOR_COUNT

MOVE WINDOW TO WORKSPACE (absolute)
  alt-shift-1-0      → Move to workspace 1-10
  alt-ctrl-1-0       → Move to workspace 11-20

WINDOW NAVIGATION (vim-style)
  alt-h/j/k/l        → Focus left/down/up/right
  alt-shift-h/j/k/l  → Move left/down/up/right

LAYOUT
  alt-f              → Toggle fullscreen
  alt-shift-f        → Reset layout (horizontal tiles)
  alt-shift-v        → 2-row grid (top/bottom rows)
  alt-ctrl-f         → All workspaces to accordion
  alt-b              → Balance sizes
  alt-d              → Distribute windows evenly

MONITORS
  cmd-1/2/3/4/5      → Focus monitor 1-5
  alt-. / alt-,      → Focus next/prev monitor
  alt-i              → Identify monitors

APPS & ACTIONS
  alt-shift-d        → Organize windows by app
  alt-shift-e        → Arrange windows (WS5 Slack, WS3 misc, rest spread)
  alt-shift-s        → Lock current layout (snapshot)
  alt-shift-a        → Reapply locked layout (best-effort)
  alt-s              → Search Chrome windows
  alt-shift-m        → Chrome tabs by memory (JS heap)
  alt-shift-r        → Reload Chrome tabs
  alt-ctrl-j         → Scroll Devin/Capy Chrome tabs to bottom

\" with title \"AeroSpace Help\" buttons {\"OK\"} default button \"OK\""

