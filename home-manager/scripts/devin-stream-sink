def _log(msg):
    print(time.strftime("%Y-%m-%dT%H:%M:%S%z") + " " + msg, flush=True)


def _resolve_openai_key():
    """Locate the OpenAI API key, cheapest source first (never logged).

    Order: OPENAI_API_KEY env var -> an `export OPENAI_API_KEY=...` line in a
    shell rc file -> the dedicated key file ~/.config/devin-stream/openai_key.
    Called lazily every cycle, so dropping a key in place enables enrichment
    without a restart.
    """
    key = (os.environ.get("OPENAI_API_KEY") or "").strip()
    if key:
        return key
    for rc in LLM_RC_FILES:
        try:
            with open(os.path.expanduser(rc)) as f:
                for line in f:
                    m = _RC_KEY_RE.match(line)
                    if m:
                        return m.group(1)
        except OSError:
            continue
    try:
        with open(LLM_KEY_FILE) as f:
            key = f.read().strip()
        if key:
            return key
    except OSError:
        pass
    return None


def _load_llm_cache():
    try:
        with open(LLM_CACHE_FILE) as f:
            data = json.load(f)
        if isinstance(data, dict):
            return data
    except (OSError, json.JSONDecodeError):
        pass
    return {}


def _save_llm_cache(cache):
    if len(cache) > LLM_CACHE_MAX:  # drop the oldest decisions
        for ck in sorted(cache, key=lambda k: str(cache[k].get("decidedAt")))[
                :len(cache) - LLM_CACHE_MAX]:
            del cache[ck]
    tmp = LLM_CACHE_FILE + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(cache, f, indent=2, ensure_ascii=False)
        os.replace(tmp, LLM_CACHE_FILE)
    except OSError:
        pass


def _llm_cache_key(sid, raw_title):
    return sid + ":" + hashlib.sha1(raw_title.encode("utf-8")).hexdigest()[:12]


def _parse_llm_reply(content):
    """Defensively extract {"symbol": ":shortcode:", "title": "..."}.

    Returns {"shortcode", "emoji", "title"} or None if the reply is garbage
    (no JSON object, unknown shortcode, empty title, ...).
    """
    if not isinstance(content, str):
        return None
    m = re.search(r"\{.*\}", content, re.S)
    if not m:
        return None
    try:
        obj = json.loads(m.group(0))
    except ValueError:
        return None
    if not isinstance(obj, dict):
        return None
    code, title = obj.get("symbol"), obj.get("title")
    if not isinstance(code, str) or not isinstance(title, str):
        return None
    code = code.strip().strip(":").lower()
    emoji = EMOJI_SHORTCODES.get(code)
    title = " ".join(title.split())[:LLM_TITLE_MAX].strip()
    if not emoji or not title:
        return None
    return {"shortcode": code, "emoji": emoji, "title": title}


def _llm_decide(api_key, raw_title, recent_messages):
    """One symbol+title decision from the model; None on any failure.

    Retries once on a garbage (unparseable/invalid) reply; network/API errors
    are not retried within a cycle -- the next cycle tries again.
    """
    transcript = []
    for msg in (recent_messages or [])[-4:]:
        if isinstance(msg, dict) and msg.get("text"):
            who = "User" if msg.get("role") == "human" else "Agent"
            transcript.append(who + ": " + str(msg["text"]))
    user_prompt = "\n".join(
        ["Session title: " + raw_title]
        + (["Recent chat (oldest first):"] + transcript if transcript else [])
        + ["",
           "Allowed emoji shortcodes: "
           + " ".join(":" + c + ":" for c in sorted(EMOJI_SHORTCODES))])
    payload = json.dumps({
        "model": LLM_MODEL,
        "messages": [
            {"role": "system", "content":
                "You label software-agent work sessions so a human can spot "
                "them at a glance. Reply with STRICT JSON only, no prose: "
                '{"symbol": ":shortcode:", "title": "<display title>"}. '
                "The symbol MUST be exactly one shortcode from the allowed "
                "list, picked to evoke this session's subject matter and to "
                "be distinctive. The title must be at most "
                + str(LLM_TITLE_MAX) + " characters: a cleaner, punchier "
                "version of the session title that keeps key identifiers "
                "(component names, PR numbers). No trailing period."},
            {"role": "user", "content": user_prompt},
        ],
    }).encode("utf-8")

    for _ in range(2):  # one retry on a garbage reply
        req = urllib.request.Request(
            LLM_API_URL, data=payload, method="POST",
            headers={"Content-Type": "application/json",
                     "Authorization": "Bearer " + api_key})
        try:
            with urllib.request.urlopen(req, timeout=LLM_TIMEOUT_S) as resp:
                body = json.loads(resp.read().decode("utf-8"))
        except (urllib.error.URLError, OSError, ValueError) as e:
            _log("llm: request failed (%s); skipping" % type(e).__name__)
            return None
        try:
            content = body["choices"][0]["message"]["content"]
        except (KeyError, IndexError, TypeError):
            content = None
        dec = _parse_llm_reply(content)
        if dec:
            return dec
    _log("llm: unparseable reply twice for %r; skipping" % raw_title[:40])
    return None


def _llm_cycle(cache, api_key):
    """One enrichment pass: apply cached decisions, then spend up to
    LLM_MAX_CALLS_PER_CYCLE API calls on sessions that lack a decision for
    their CURRENT raw title (new sessions or renamed ones), freshest first.
    """
    # Deep-copy the fields this cycle needs while holding the lock: the
    # handler thread mutates these summary dicts (and re-sorts their
    # recentMessages lists) concurrently, so live references must not be
    # read outside the lock. The snapshot keeps the lock hold short and the
    # LLM network calls entirely lock-free.
    with STATE_LOCK:
        items = sorted(
            ({"sid": sid, "title": s.get("title"),
              "recentMessages": [dict(m)
                                 for m in (s.get("recentMessages") or [])],
              "decidedTitle": s.get("decidedTitle"),
              "symbol": s.get("symbol"),
              "lastSeen": str(s.get("lastSeen") or "")}
             for sid, s in STATE["summary"].items()),
            key=lambda it: it["lastSeen"], reverse=True)
    calls = 0
    changed = False
    for it in items:
        sid, raw_title = it["sid"], it["title"]
        if not raw_title:
            continue
        ck = _llm_cache_key(sid, raw_title)
        dec = cache.get(ck)
        if dec is None:
            if not api_key or calls >= LLM_MAX_CALLS_PER_CYCLE:
                continue
            calls += 1
            dec = _llm_decide(api_key, raw_title, it["recentMessages"])
            if dec is None:
                continue  # keep the previous decision / consumer fallback
            dec["rawTitle"] = raw_title
            dec["decidedAt"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
            cache[ck] = dec
            _save_llm_cache(cache)
            _log("llm: %s -> %s %r" % (sid[:8], dec["emoji"], dec["title"]))
        if (it["decidedTitle"] != dec["title"]
                or it["symbol"] != dec["emoji"]):
            with STATE_LOCK:
                summ = STATE["summary"].get(sid)
                if summ is None:
                    continue
                summ["rawTitle"] = raw_title
                summ["decidedTitle"] = dec["title"]
                summ["symbol"] = dec["emoji"]
                summ["symbolShortcode"] = dec["shortcode"]
                summ["decidedAt"] = dec["decidedAt"]
            changed = True
    if changed:
        _write_latest()


def _llm_loop():
    cache = _load_llm_cache()
    warned_no_key = False
    while True:
        try:
            api_key = _resolve_openai_key()
            if not api_key and not warned_no_key:
                _log("llm: no OpenAI key found (env OPENAI_API_KEY, shell rc,"
                     " or %s); enrichment disabled" % LLM_KEY_FILE)
                warned_no_key = True
            _llm_cycle(cache, api_key)
        except Exception as e:  # never let the thread die
            _log("llm: cycle error: %r" % (e,))
        time.sleep(LLM_CYCLE_S)


def _apply(record):
    """Fold one envelope into the aggregated in-memory snapshot.

    Mutates STATE only -- callers must hold STATE_LOCK. The per-session
    disk log lives in _log_session so file I/O stays outside the lock.
    """
    STATE["updatedAt"] = record["ts"]
    kind = record.get("kind")

    if kind == "discovery":
        STATE["discovery"] = record
        return

    # The summary keys off ids inside the payloads (devin_id / URL), not the
    # envelope's sessionId, so fold before the sessionId guard: org-wide
    # endpoints like v2sessions describe many sessions at once.
    if kind == "net":
        _fold_net(record)

    sid = _safe_session_id(record.get("sessionId"))
    if sid is None:
        return

    sess = STATE["sessions"].get(sid) or {"sessionId": sid, "events": 0}
    sess["events"] += 1
    sess["lastSeen"] = record["ts"]
    if record.get("url"):
        sess["url"] = record["url"]
    if record.get("tabId") is not None:
        sess["tabId"] = record["tabId"]
    # Merge channel-specific data so latest.json shows the freshest view.
    data = record.get("data")
    if isinstance(data, dict):
        sess.setdefault("latest", {})
        sess["latest"][kind or "event"] = data
        for k in ("title", "status", "awaiting"):
            if k in data:
                sess[k] = data[k]
    STATE["sessions"][sid] = sess


def _log_session(record):
    """Per-session append-only log (pure file I/O; no STATE access)."""
    sid = _safe_session_id(record.get("sessionId"))
    if sid is None:
        return
    path = os.path.join(SESSIONS_DIR, sid + ".jsonl")
    _rotate(path, MAX_SESSION_LOG_BYTES)
    with open(path, "a") as f:
        f.write(json.dumps(record, default=str) + "\n")


class Handler(BaseHTTPRequestHandler):
    def _respond(self, code, body):
        return self._respond_raw(code, json.dumps(body, default=str).encode())

    def _respond_raw(self, code, data):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_POST(self):
        if self.path != "/ingest":
            return self._respond(404, {"error": "unknown path"})
        try:
            length = int(self.headers.get("Content-Length", 0))
            payload = json.loads(self.rfile.read(length))
        except (ValueError, json.JSONDecodeError):
            return self._respond(400, {"error": "bad json"})

        # Accept either a single envelope or a batch under "events".
        events = payload.get("events") if isinstance(payload, dict) else None
        if not isinstance(events, list):
            events = [payload]

        # File I/O (event log, per-session logs) runs unlocked; only the
        # STATE folds need the lock, and they're pure in-memory dict work,
        # so the LLM thread is never blocked behind disk writes.
        ts = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        _rotate(LOG_FILE, MAX_LOG_BYTES)
        records = []
        with open(LOG_FILE, "a") as f:
            for ev in events:
                if not isinstance(ev, dict):
                    continue
                record = {"ts": ts, **ev}
                f.write(json.dumps(record, default=str) + "\n")
                records.append(record)
        with STATE_LOCK:
            for record in records:
                _apply(record)
        for record in records:
            _log_session(record)
        _write_latest()
        self._respond(200, {"ok": True, "ingested": len(records)})

    def do_GET(self):
        # SERIALIZE under the lock (json.dumps iterates STATE, and the
        # ingest fold / LLM thread insert keys concurrently -- "dictionary
        # changed size during iteration"), but write to the SOCKET outside
        # it, so a slow client can never stall the other thread.
        if self.path.startswith("/state"):
            with STATE_LOCK:
                data = json.dumps(STATE, default=str).encode()
            return self._respond_raw(200, data)
        if self.path.startswith("/summary"):
            with STATE_LOCK:
                data = json.dumps({
                    "sessions": STATE["summary"],
                    "updatedAt": STATE["updatedAt"],
                }, default=str).encode()
            return self._respond_raw(200, data)
        # Every session id the sink has ever summarized, with its last
        # observation time -- drives the devin-stream extension's slow
        # rolling backfill of dormant sessions (see its background.js).
        if self.path.startswith("/session-ids"):
            with STATE_LOCK:
                ids = [{"id": sid, "lastSeen": s.get("lastSeen")}
                       for sid, s in STATE["summary"].items()]
            return self._respond(200, {"ids": ids, "count": len(ids)})
        return self._respond(404, {"error": "unknown path"})

    def log_message(self, *args):
        pass  # keep launchd logs quiet


def main():
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    # Stale temp files from a crash mid-write (incl. the old shared-name
    # scheme) are dead weight; latest.json itself is always complete thanks
    # to the os.replace publish.
    for name in os.listdir(STATE_DIR):
        if name.startswith(os.path.basename(LATEST_FILE) + ".") \
                and name.endswith(".tmp"):
            try:
                os.remove(os.path.join(STATE_DIR, name))
            except OSError:
                pass
    # Everything below runs single-threaded: the LLM thread and the HTTP
    # server only start after the backfill completes, so these boot-time
    # STATE mutations don't need the lock.
    _load_latest()
    # Keep the persisted summary rather than resetting it: at current capture
    # volume the retained event logs rotate away within minutes, so a fresh
    # backfill forgets the accumulated status of every session without very
    # recent traffic. Re-derive awaiting under current rules, then re-fold the
    # retained logs on top (idempotent, newest-timestamp-wins).
    for sid in list(STATE["summary"]):
        _derive_awaiting(_summary_for(sid))
    _backfill_summary()
    threading.Thread(target=_llm_loop, name="llm-enrich", daemon=True).start()
    # Deliberately the plain single-threaded HTTPServer: requests are
    # handled one at a time on this thread, so STATE is only ever contended
    # between the handler thread and the LLM daemon thread (see STATE_LOCK).
    # Do not swap in ThreadingHTTPServer without re-auditing the locking.
    HTTPServer(("127.0.0.1", PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
