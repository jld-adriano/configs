#!/usr/bin/env python3
"""Local sink for the devin-stream Chrome extension (launchd service).

The extension captures live data from logged-in app.devin.ai tabs and POSTs it
here. Every event is an envelope:

    {
      "source": "devin-stream",
      "kind":   "net" | "discovery" | "session" | "event",
      "sessionId": "<uuid or null>",
      "tabId": <int>, "url": "...", "bootId": "...",
      "data": { ...channel-specific payload... }
    }

We persist three things under ~/.local/state/devin-stream/ so the stream can be
inspected and iterated on from outside the browser:

  * events.jsonl          -- append-only log of every envelope (rotated at 50MB)
  * sessions/<id>.jsonl   -- per-session event log keyed by session id
  * latest.json           -- aggregated snapshot: newest state per session plus
                             the most recent discovery inventory

On top of the raw capture we maintain a clean per-session SUMMARY, folded from
the captured Devin API payloads as they arrive (and backfilled from
events.jsonl on first start):

    summary[sessionId] = {title, rawTitle, status, statusEnum, statusMessage,
                          statusEnumAt, awaiting,
                          prs: [{number,title,url,state,merged,
                          draft}], lastHumanMessage, lastAgentMessage,
                          recentMessages: [{role: "human"|"agent", text, ts}]
                          (last 4 chat messages, oldest -> newest), lastSeen,
                          decidedTitle, symbol, symbolShortcode, decidedAt}

On top of THAT, an optional LLM enrichment thread asks OpenAI (model
gpt-5.5-mini) to pick a display SYMBOL (an emoji, chosen by shortcode from
EMOJI_SHORTCODES below) and a short DECIDED TITLE for each session, from the
raw title + the transcript tail. Consumers (window-colors banner/badge,
dashboard cards) prefer decidedTitle/symbol and fall back to the raw title /
hash-slot symbols when enrichment hasn't happened. Decisions are cached in
~/.local/state/devin-stream/llm_decisions.json keyed by session id + a hash
of the raw title, so restarts never re-bill and a changed title triggers a
fresh decision. The API key is resolved lazily (env OPENAI_API_KEY, then a
shell-rc export line, then ~/.config/devin-stream/openai_key); with no key
the enrichment quietly disables itself and everything else keeps working.

`awaiting` is derived here (single source of truth) so consumers -- notably
the window-colors extension's banner/awaiting line -- never need to scan the
page DOM. Mapping, cross-validated 2026-07-09 against the text-based awaiting
flags the window-colors content script used to compute from page text:

    status:  "running" | "suspended" | "completed"   (session lifecycle)
    enum:    "blocked" | "working" | "finished"      (status_update events /
                                                      latest_status_contents)

    awaiting = (enum == "blocked")          # "Waiting for your response"
               or (status == "suspended")   # asleep ("Devin went to sleep",
                                            # incl. crashed/user_inactivity)

Every tab whose text scan said awaiting=true and that had sink coverage was
either suspended, or running with enum "blocked"; enum "working" ("Devin is
thinking...") and plain running sessions were never text-awaiting.

Payload sources (documented from captured traffic):
  * GET .../v2sessions            -> result[]: devin_id, title, status,
        pull_requests [{state, pr_url, draft}],
        latest_message_contents / initial_user_message_contents
        ({type: devin_message|user_message|initial_user_message, message, ts}).
        last*Message selection is by max message timestamp per side;
        initial_user_message is only a fallback when no user_message exists
  * GET /api/events/devin-<id>/stream -> {"result":[{event}...]} message
        history (same event types as the live WS)
  * GET /api/sessions/devin-<id>  -> same shape, single session
  * GET /api/sessions/devin-<id>/prs -> [{pr_url, state, draft,
        github_pr_data:{merged, number, title, ...}}] (bodies truncated at
        24KB by the extension, so this is parsed with regexes)
  * WS  /api/events/devin-<id>/live -> {type:"devin_event", devin_id,
        event:{type, message, timestamp, ...}}. Chat messages are event types
        devin_message (agent) and user_message/initial_user_message (human);
        reasoning/tool types (devin_thoughts, one_line_thoughts,
        thought_summary, shell_*, terminal_update, mcp_*, ...) are excluded,
        as are streaming partials (ops frames without a full "message").

Inspect with:

    curl -s 127.0.0.1:48292/state | jq .      # full snapshot incl. summary
    curl -s 127.0.0.1:48292/summary | jq .    # just the per-session summary
    tail -f ~/.local/state/devin-stream/events.jsonl
    ls ~/.local/state/devin-stream/sessions/
"""

import hashlib
import json
import os
import re
import threading
import time
import urllib.error
import urllib.request
from datetime import datetime
from http.server import BaseHTTPRequestHandler, HTTPServer

PORT = 48292
STATE_DIR = os.path.expanduser("~/.local/state/devin-stream")
SESSIONS_DIR = os.path.join(STATE_DIR, "sessions")
LOG_FILE = os.path.join(STATE_DIR, "events.jsonl")
LATEST_FILE = os.path.join(STATE_DIR, "latest.json")
MAX_LOG_BYTES = 50 * 1024 * 1024
MAX_SESSION_LOG_BYTES = 10 * 1024 * 1024

# Filesystem-safe session id: Devin session ids are uuids, but be defensive so a
# malformed id can never escape the sessions/ directory.
SAFE_ID = re.compile(r"[^A-Za-z0-9_.-]")

# In-memory aggregate; also mirrored to latest.json on every write so a restart
# can reload it. "summary" is the clean per-session view folded from the
# captured Devin API payloads (see module docstring for the payload paths).
STATE = {"sessions": {}, "discovery": None, "summary": {}, "updatedAt": None}

# The HTTP server (main thread) and the LLM enrichment thread both mutate
# STATE and serialize it (latest.json, GET responses); serializing a dict
# while the other thread inserts keys raises RuntimeError, hence the lock.
# Never held across network calls.
STATE_LOCK = threading.Lock()


def _rotate(path, limit):
    try:
        if os.path.getsize(path) > limit:
            os.replace(path, path + ".old")
    except OSError:
        pass


def _safe_session_id(sid):
    if not sid or not isinstance(sid, str):
        return None
    sid = SAFE_ID.sub("_", sid)[:128]
    return sid or None


def _load_latest():
    try:
        with open(LATEST_FILE) as f:
            data = json.load(f)
        if isinstance(data, dict):
            STATE.update({k: data.get(k, STATE[k]) for k in STATE})
    except (OSError, json.JSONDecodeError):
        pass


def _write_latest():
    tmp = LATEST_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(STATE, f, indent=2, default=str)
    os.replace(tmp, LATEST_FILE)


# ── Per-session summary (folded from captured Devin API payloads) ───────────

MSG_TRUNC = 300
# recentMessages: the last few chat messages (transcript tail) kept per
# session, oldest -> newest, with a larger per-message truncation.
RECENT_MSGS = 4
RECENT_TRUNC = 600
# "initial_user_message" is deliberately NOT a lastHumanMessage source: it is
# by definition the session's FIRST message, so it only serves as a fallback
# when no real user_message was ever captured (see _note_message).
HUMAN_MSG_TYPES = {"user_message"}
INITIAL_HUMAN_TYPE = "initial_user_message"
AGENT_MSG_TYPES = {"devin_message"}

# Trim sub-microsecond precision (WS events carry nanoseconds) so
# datetime.fromisoformat can parse the timestamp.
_FRAC = re.compile(r"(\.\d{6})\d+")
_SESSION_API = re.compile(r"/api/sessions/devin-([0-9a-f]+)(/prs)?$")
# v2sessions bodies are truncated at 24KB by the extension, so only the
# leading 1-2 session objects survive JSON decoding -- but the truncated TAIL
# still names every session. These regexes sweep the raw body for
# (devin_id, status) pairs and each object's latest_status_contents (a flat
# object), which is what the awaiting derivation needs. The tempered
# (?!"devin_id") guard keeps a match from spilling into the next session
# object when a field is missing.
_V2_SID_STATUS = re.compile(
    r'"devin_id":\s*"devin-([0-9a-f]+)",\s*"status":\s*"(\w+)"')
_V2_SID_STATUS_CONTENTS = re.compile(
    r'"devin_id":\s*"devin-([0-9a-f]+)"'
    r'(?:(?!"devin_id":)[\s\S]){0,30000}?'
    r'"latest_status_contents":\s*(\{(?:[^{}"]|"(?:[^"\\]|\\.)*")*\})')
# /prs bodies are truncated at 24KB by the extension, so they can't be
# json.loads'd; the leading fields of each item are extracted with a regex.
_PR_ITEM = re.compile(
    r'"pr_url"\s*:\s*"([^"]+)"\s*,\s*"state"\s*:\s*"(\w+)"\s*,\s*"draft"\s*:\s*(true|false)'
)


def _epoch(ts):
    if not ts or not isinstance(ts, str):
        return 0.0
    try:
        return datetime.fromisoformat(
            _FRAC.sub(r"\1", ts.replace("Z", "+00:00"))
        ).timestamp()
    except ValueError:
        return 0.0


def _trunc_msg(text, limit=MSG_TRUNC):
    text = " ".join(str(text).split())
    return text[:limit] + ("…" if len(text) > limit else "")


def _summary_for(sid):
    summ = STATE["summary"].setdefault(sid, {
        "title": None, "rawTitle": None, "status": None, "prs": [],
        "statusEnum": None, "statusEnumAt": None, "statusMessage": None,
        "awaiting": False,
        "lastHumanMessage": None, "lastHumanMessageAt": None,
        "lastAgentMessage": None, "lastAgentMessageAt": None,
        "recentMessages": [],
        "lastSeen": None,
        "decidedTitle": None, "symbol": None, "symbolShortcode": None,
        "decidedAt": None,
    })
    # Entries loaded from latest.json may predate newer fields.
    summ.setdefault("recentMessages", [])
    for k in ("statusEnum", "statusEnumAt", "statusMessage", "rawTitle",
              "decidedTitle", "symbol", "symbolShortcode", "decidedAt"):
        summ.setdefault(k, None)
    summ.setdefault("awaiting", False)
    return summ


def _sid_from_devin_id(devin_id):
    if not isinstance(devin_id, str):
        return None
    if devin_id.startswith("devin-"):
        devin_id = devin_id[len("devin-"):]
    return _safe_session_id(devin_id)


def _note_message(summ, contents):
    """Record a chat message if it's newer (max message timestamp wins).

    Only full chat messages count: user_message (human) and devin_message
    (agent). Reasoning/tool event types (devin_thoughts, one_line_thoughts,
    thought_summary, shell_*, terminal_update, mcp_*, ...) are excluded, as
    are streaming partials (ops-frames carry no "message").

    Selection is strictly by the message's OWN timestamp -- never the capture
    time: v2sessions re-sends old contents on every poll, so stamping them
    with capture time made the FIRST user message look perpetually newest.
    A message without a timestamp only fills an empty slot (epoch 0).

    initial_user_message is handled apart: it is the session's first message,
    used only as a fallback while no real user_message has been captured.
    """
    if not isinstance(contents, dict):
        return
    text = contents.get("message")
    if not isinstance(text, str) or not text.strip():
        return
    mtype = contents.get("type")
    if mtype == INITIAL_HUMAN_TYPE:
        if summ["lastHumanMessage"] is None:
            summ["lastHumanMessage"] = _trunc_msg(text)
            summ["lastHumanMessageAt"] = contents.get("timestamp")
        return
    if mtype in HUMAN_MSG_TYPES:
        key, role = "lastHumanMessage", "human"
    elif mtype in AGENT_MSG_TYPES:
        key, role = "lastAgentMessage", "agent"
    else:
        return
    ts = contents.get("timestamp")
    _note_recent(summ, role, text, ts)
    if _epoch(ts) >= _epoch(summ.get(key + "At")):
        summ[key] = _trunc_msg(text)
        summ[key + "At"] = ts


def _note_recent(summ, role, text, ts):
    """Keep the last RECENT_MSGS chat messages, oldest -> newest.

    Deduped by (role, ts): the same message arrives repeatedly (v2sessions
    re-polls, WS streaming finals, backfill), and a re-arrival may carry a
    longer final text, so it replaces the stored one. Untimestamped messages
    are skipped -- they can't be ordered into a transcript.
    """
    if not ts:
        return
    recent = summ["recentMessages"]
    for m in recent:
        if m["ts"] == ts and m["role"] == role:
            m["text"] = _trunc_msg(text, RECENT_TRUNC)
            return
    recent.append({"role": role, "text": _trunc_msg(text, RECENT_TRUNC), "ts": ts})
    recent.sort(key=lambda m: _epoch(m["ts"]))
    del recent[:-RECENT_MSGS]


def _derive_awaiting(summ):
    """awaiting = needs the user: blocked on a response, or asleep.

    Mapping derived by cross-validating captured statuses against the old
    text-based detection (see module docstring). "blocked" comes from
    status_update events ("Waiting for your response"); "suspended" covers
    sleep from user inactivity and crashes ("Devin went to sleep").
    """
    summ["awaiting"] = (summ.get("statusEnum") == "blocked"
                        or summ.get("status") == "suspended")


def _note_status(summ, enum, message, ts):
    """Record a status_update if it's newer (by its own timestamp).

    Sources re-send old contents (v2sessions polls carry
    latest_status_contents on every poll), so newest-timestamp-wins, same as
    _note_message. An untimestamped update only fills an empty slot.
    """
    if not enum:
        return
    if _epoch(ts) >= _epoch(summ.get("statusEnumAt")):
        summ["statusEnum"] = enum
        summ["statusEnumAt"] = ts
        summ["statusMessage"] = _trunc_msg(message, 120) if message else None
    _derive_awaiting(summ)


def _note_pr(summ, url, state=None, draft=None, merged=None):
    if not url:
        return
    for pr in summ["prs"]:
        if pr["url"] == url:
            break
    else:
        num = re.search(r"/pull/(\d+)", url)
        pr = {"number": int(num.group(1)) if num else None, "title": None,
              "url": url, "state": None, "merged": False, "draft": False}
        summ["prs"].append(pr)
    if state is not None:
        pr["state"] = state
        pr["merged"] = (state == "merged") if merged is None else bool(merged)
    elif merged is not None:
        pr["merged"] = bool(merged)
    if draft is not None:
        pr["draft"] = bool(draft)


_DECODER = json.JSONDecoder()


def _iter_truncated_array(body, prefix):
    """Yield complete JSON objects from a possibly-truncated `prefix[{...},...`.

    The extension truncates net bodies at 24KB, so large v2sessions //stream
    responses fail json.loads; decoding item by item still recovers every
    complete leading element.
    """
    if not body.startswith(prefix):
        return
    i = len(prefix)
    while True:
        try:
            obj, i = _DECODER.raw_decode(body, i)
        except ValueError:
            return
        if isinstance(obj, dict):
            yield obj
        while i < len(body) and body[i] in ", \t\r\n":
            i += 1
        if i >= len(body) or body[i] == "]":
            return


def _fold_session_obj(obj, ts):
    """Fold one session object from v2sessions / session-detail payloads."""
    sid = _sid_from_devin_id(obj.get("devin_id"))
    if not sid:
        return
    summ = _summary_for(sid)
    summ["lastSeen"] = ts
    if obj.get("title"):
        summ["title"] = obj["title"]
        summ["rawTitle"] = obj["title"]
    if obj.get("status"):
        summ["status"] = obj["status"]
        _derive_awaiting(summ)
    lsc = obj.get("latest_status_contents")
    if isinstance(lsc, dict):
        _note_status(summ, lsc.get("enum"), lsc.get("message"),
                     lsc.get("timestamp") or obj.get("latest_status_event_at"))
    for pr in obj.get("pull_requests") or []:
        if isinstance(pr, dict):
            _note_pr(summ, pr.get("pr_url"),
                     state=pr.get("state"), draft=pr.get("draft"))
    _note_message(summ, obj.get("initial_user_message_contents"))
    _note_message(summ, obj.get("latest_message_contents"))


def _sweep_v2_statuses(body, ts):
    """Recover (status, latest_status_contents) from a truncated v2sessions
    body for EVERY session named in it, not just the 1-2 leading objects that
    survive JSON decoding. Idempotent with the decoded path."""
    for m in _V2_SID_STATUS.finditer(body):
        sid = _safe_session_id(m.group(1))
        if not sid:
            continue
        summ = _summary_for(sid)
        summ["lastSeen"] = ts
        summ["status"] = m.group(2)
        _derive_awaiting(summ)
    for m in _V2_SID_STATUS_CONTENTS.finditer(body):
        sid = _safe_session_id(m.group(1))
        if not sid:
            continue
        try:
            lsc = json.loads(m.group(2))
        except ValueError:
            continue
        _note_status(_summary_for(sid), lsc.get("enum"), lsc.get("message"),
                     lsc.get("timestamp"))


def _fold_net(record):
    """Fold one captured net envelope into the per-session summary."""
    d = record.get("data")
    if not isinstance(d, dict):
        return
    body = d.get("body")
    if not isinstance(body, str) or not body:
        return
    ts = record.get("ts")

    if d.get("channel") == "ws":
        try:
            frame = json.loads(body)
        except ValueError:
            return
        if not isinstance(frame, dict) or frame.get("type") != "devin_event":
            return
        sid = _sid_from_devin_id(frame.get("devin_id"))
        ev = frame.get("event")
        if sid and isinstance(ev, dict):
            summ = _summary_for(sid)
            summ["lastSeen"] = ts
            if ev.get("type") == "status_update":
                _note_status(summ, ev.get("enum"), ev.get("message"),
                             ev.get("timestamp"))
            else:
                _note_message(summ, ev)
        return

    url = (d.get("url") or "").split("?")[0]
    if url.endswith("/v2sessions"):
        try:
            b = json.loads(body)
            items = (b.get("result") or []) if isinstance(b, dict) else []
        except ValueError:  # truncated body: recover the complete lead items
            items = _iter_truncated_array(body, '{"result":[')
        for obj in items:
            if isinstance(obj, dict):
                _fold_session_obj(obj, ts)
        _sweep_v2_statuses(body, ts)
        return

    # Message-history endpoint: /api/events/devin-<id>/stream returns
    # {"result":[{event}...]} with the same event types as the live WS.
    em = re.search(r"/api/events/devin-([0-9a-f]+)/stream$", url)
    if em:
        sid = _safe_session_id(em.group(1))
        if not sid:
            return
        summ = _summary_for(sid)
        summ["lastSeen"] = ts
        for ev in _iter_truncated_array(body, '{"result":['):
            _note_message(summ, ev)
        return

    m = _SESSION_API.search(url)
    if not m:
        return
    if m.group(2):  # /prs endpoint (body usually truncated -> regex)
        sid = _safe_session_id(m.group(1))
        if not sid:
            return
        summ = _summary_for(sid)
        summ["lastSeen"] = ts
        for pm in _PR_ITEM.finditer(body):
            _note_pr(summ, pm.group(1),
                     state=pm.group(2), draft=pm.group(3) == "true")
    else:  # single-session detail
        try:
            b = json.loads(body)
        except ValueError:
            return
        if isinstance(b, dict) and b.get("devin_id"):
            _fold_session_obj(b, ts)


def _backfill_summary():
    """Rebuild the summary from the retained event logs at startup.

    Idempotent (newest-timestamp-wins), so re-folding on every boot is safe
    and keeps the summary consistent with the current parse rules.
    """
    for path in (LOG_FILE + ".old", LOG_FILE):
        try:
            f = open(path)
        except OSError:
            continue
        with f:
            for line in f:
                try:
                    record = json.loads(line)
                except (ValueError, json.JSONDecodeError):
                    continue
                if isinstance(record, dict) and record.get("kind") == "net":
                    _fold_net(record)


# ── LLM enrichment (symbol + decided title per session) ─────────────────────
# A background thread periodically asks OpenAI to pick a distinctive emoji
# (by shortcode, validated against EMOJI_SHORTCODES) and a punchier display
# title for each session, from the raw title + transcript tail. Decisions are
# cached persistently keyed by session id + raw-title hash, so restarts never
# re-bill and a title change triggers exactly one new decision.

LLM_MODEL = "gpt-5.5-mini"
LLM_API_URL = "https://api.openai.com/v1/chat/completions"
LLM_CYCLE_S = 60
LLM_MAX_CALLS_PER_CYCLE = 5
LLM_TITLE_MAX = 60
LLM_TIMEOUT_S = 45
LLM_CACHE_FILE = os.path.join(STATE_DIR, "llm_decisions.json")
LLM_CACHE_MAX = 2000
LLM_KEY_FILE = os.path.expanduser("~/.config/devin-stream/openai_key")
LLM_RC_FILES = ("~/.zshrc", "~/.zshenv", "~/.zprofile",
                "~/.bashrc", "~/.bash_profile", "~/.profile")
_RC_KEY_RE = re.compile(
    r'^\s*(?:export\s+)?OPENAI_API_KEY=["\']?([A-Za-z0-9_-]+)["\']?\s*$')

