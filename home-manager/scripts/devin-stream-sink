#!/usr/bin/env python3
"""Local sink for the devin-stream Chrome extension (launchd service).

The extension captures live data from logged-in app.devin.ai tabs and POSTs it
here. Every event is an envelope:

    {
      "source": "devin-stream",
      "kind":   "net" | "discovery" | "session" | "event",
      "sessionId": "<uuid or null>",
      "tabId": <int>, "url": "...", "bootId": "...",
      "data": { ...channel-specific payload... }
    }

We persist three things under ~/.local/state/devin-stream/ so the stream can be
inspected and iterated on from outside the browser:

  * events.jsonl          -- append-only log of every envelope (rotated at 50MB)
  * sessions/<id>.jsonl   -- per-session event log keyed by session id
  * latest.json           -- aggregated snapshot: newest state per session plus
                             the most recent discovery inventory

On top of the raw capture we maintain a clean per-session SUMMARY, folded from
the captured Devin API payloads as they arrive (and backfilled from
events.jsonl on first start):

    summary[sessionId] = {title, rawTitle, status, statusEnum, statusMessage,
                          statusEnumAt, awaiting,
                          costUsd, acuUsed, costAt,
                          prs: [{number,title,url,state,merged,
                          draft,observedAt}], prsAt,
                          lastHumanMessage, lastAgentMessage,
                          recentMessages: [{role: "human"|"agent", text, ts}]
                          (last 6 chat messages, oldest -> newest; the latest
                          HUMAN message is always represented -- see
                          _ensure_human_recent), lastSeen,
                          decidedTitle, symbol, symbolShortcode, decidedAt}

On top of THAT, an optional LLM enrichment thread asks OpenAI (model
gpt-5.5-mini) to pick a display SYMBOL (an emoji, chosen by shortcode from
EMOJI_SHORTCODES below) and a short DECIDED TITLE for each session, from the
raw title + the transcript tail. Consumers (window-colors banner/badge,
dashboard cards) prefer decidedTitle/symbol and fall back to the raw title /
hash-slot symbols when enrichment hasn't happened. Decisions are cached in
~/.local/state/devin-stream/llm_decisions.json keyed by session id + a hash
of the raw title, so restarts never re-bill and a changed title triggers a
fresh decision. The API key is resolved lazily (env OPENAI_API_KEY, then a
shell-rc export line, then ~/.config/devin-stream/openai_key); with no key
the enrichment quietly disables itself and everything else keeps working.

`awaiting` is derived here (single source of truth) so consumers -- notably
the window-colors extension's banner/awaiting line -- never need to scan the
page DOM. Mapping, cross-validated 2026-07-09 against the text-based awaiting
flags the window-colors content script used to compute from page text:

    status:  "running" | "suspended" | "completed"   (session lifecycle)
    enum:    "blocked" | "working" | "finished"      (status_update events /
                                                      latest_status_contents)

    awaiting = (enum == "blocked")          # "Waiting for your response"
               or (status == "suspended")   # asleep ("Devin went to sleep",
                                            # incl. crashed/user_inactivity)

Every tab whose text scan said awaiting=true and that had sink coverage was
either suspended, or running with enum "blocked"; enum "working" ("Devin is
thinking...") and plain running sessions were never text-awaiting.

Payload sources (documented from captured traffic):
  * GET .../v2sessions            -> result[]: devin_id, title, status,
        pull_requests [{state, pr_url, draft}],
        latest_message_contents / initial_user_message_contents
        ({type: devin_message|user_message|initial_user_message, message, ts}).
        last*Message selection is by max message timestamp per side;
        initial_user_message is only a fallback when no user_message exists
  * GET /api/events/devin-<id>/stream -> {"result":[{event}...]} message
        history (same event types as the live WS)
  * GET /api/sessions/devin-<id>  -> same shape, single session
  * GET /api/sessions/devin-<id>/prs -> [{pr_url, state, draft,
        github_pr_data:{merged, number, title, ...}}] (bodies truncated at
        24KB by the extension, so this is parsed with regexes)

  PR folding is per-PR newest-observation-wins (keyed by pr_url, ordered by
  capture time, kept as observedAt): a laggy tab's older capture can arrive
  AFTER a fresher poll and must not regress a state -- v2sessions bodies
  carry no per-PR timestamp, so arrival-order last-write-wins used to let
  stale "open" overwrite "merged" (and the boot backfill re-folds up to an
  hour of old captures over the fresh persisted summary). Additionally, a
  fully-decoded session object's pull_requests list is the AUTHORITATIVE
  current PR set, so it REPLACES the summary's set (dropping PRs Devin no
  longer lists, e.g. detached ones) -- prsAt records the replacement time.
  Truncated partial sweeps (the /prs regex; any path that never decoded the
  session's full row) only upsert individual PRs and never drop any.
  * GET /api/billing/usage/session/devin-<id> -> {acu_used,
        acu_used_since_last_reset, max_acu_limit, overage_dollars,
        overage_dollars_since_last_reset}. The per-session dollar figure is
        overage_dollars (observed: acu_used is always 0 and
        acu_used_since_last_reset goes negative once the plan's ACUs are
        exhausted; overage_dollars tracks the session's billed dollars) ->
        summary costUsd. acu_used is kept as acuUsed only when positive.
        Only sessions whose tabs captured such a request carry cost data.
  * WS  /api/events/devin-<id>/live -> {type:"devin_event", devin_id,
        event:{type, message, timestamp, ...}}. Chat messages are event types
        devin_message (agent) and user_message/initial_user_message (human);
        reasoning/tool types (devin_thoughts, one_line_thoughts,
        thought_summary, shell_*, terminal_update, mcp_*, ...) are excluded,
        as are streaming partials (ops frames without a full "message").
  * WS  send frames on the same socket -- the user's OUTGOING chat message
        ({type:"user_message", message, origin:"web", ...}) -- are folded
        IMMEDIATELY, stamped with capture time, so the banner shows the human
        turn without waiting for the server echo or a v2sessions poll. The
        server-timestamped copy arriving later collapses into the same entry
        (near-duplicate guard: same role + normalized text within 5 min).
  * "request" captures -- OUTGOING POST bodies from inject.js -- are parsed
        the same way for message/send/chat-ish api paths (defensive: no REST
        send endpoint observed yet; unparsed send POSTs are logged).

Inspect with:

    curl -s 127.0.0.1:48292/state | jq .      # full snapshot incl. summary
    curl -s 127.0.0.1:48292/summary | jq .    # just the per-session summary
    curl -s 127.0.0.1:48292/session-ids | jq . # all known ids + lastSeen
                                               # (drives the ext's backfill)
    tail -f ~/.local/state/devin-stream/events.jsonl
    ls ~/.local/state/devin-stream/sessions/
"""

import hashlib
import json
import os
import re
import threading
import time
import urllib.error
import urllib.request
from datetime import datetime
from http.server import BaseHTTPRequestHandler, HTTPServer

PORT = 48292
STATE_DIR = os.path.expanduser("~/.local/state/devin-stream")
SESSIONS_DIR = os.path.join(STATE_DIR, "sessions")
LOG_FILE = os.path.join(STATE_DIR, "events.jsonl")
LATEST_FILE = os.path.join(STATE_DIR, "latest.json")
MAX_LOG_BYTES = 50 * 1024 * 1024
MAX_SESSION_LOG_BYTES = 10 * 1024 * 1024

# Filesystem-safe session id: Devin session ids are uuids, but be defensive so a
# malformed id can never escape the sessions/ directory.
SAFE_ID = re.compile(r"[^A-Za-z0-9_.-]")

# In-memory aggregate; also mirrored to latest.json on every write so a restart
# can reload it. "summary" is the clean per-session view folded from the
# captured Devin API payloads (see module docstring for the payload paths).
STATE = {"sessions": {}, "discovery": None, "summary": {}, "updatedAt": None}

# Threading model: the HTTP server is a plain single-threaded HTTPServer
# (one request at a time, on the main thread), so EXACTLY TWO threads touch
# STATE: the request-handler thread (POST /ingest folds captures; GETs
# serialize summaries) and the LLM enrichment daemon thread. Serializing or
# iterating a dict while the other thread inserts keys raises RuntimeError
# ("dictionary changed size during iteration") and can produce torn reads,
# hence one RLock guarding every STATE mutation and every read that
# iterates/serializes it. Hold times stay short: snapshot/serialize under
# the lock, do network and slow I/O outside; never held across LLM calls.
STATE_LOCK = threading.RLock()


def _rotate(path, limit):
    try:
        if os.path.getsize(path) > limit:
            os.replace(path, path + ".old")
    except OSError:
        pass


def _safe_session_id(sid):
    if not sid or not isinstance(sid, str):
        return None
    sid = SAFE_ID.sub("_", sid)[:128]
    return sid or None


def _load_latest():
    try:
        with open(LATEST_FILE) as f:
            data = json.load(f)
        if isinstance(data, dict):
            STATE.update({k: data.get(k, STATE[k]) for k in STATE})
    except (OSError, json.JSONDecodeError):
        pass


def _write_latest():
    """Persist STATE to latest.json atomically.

    Serialization iterates STATE, so it happens under the lock; the multi-MB
    file write happens OUTSIDE the lock and goes to a UNIQUE temp file that
    is os.replace'd into place, so a concurrent reader (or a crash mid-write)
    never sees a half-written latest.json. The temp name is unique per
    thread: the old shared ".tmp" path let the handler thread and the LLM
    thread interleave writes into the same temp file (a stale multi-hundred-
    KB latest.json.tmp was found on disk), which os.replace would then have
    published as garbage.
    """
    with STATE_LOCK:
        data = json.dumps(STATE, indent=2, default=str)
    tmp = "%s.%d.%d.tmp" % (LATEST_FILE, os.getpid(), threading.get_ident())
    try:
        with open(tmp, "w") as f:
            f.write(data)
        os.replace(tmp, LATEST_FILE)
    except OSError:
        try:
            os.remove(tmp)
        except OSError:
            pass


# ── Per-session summary (folded from captured Devin API payloads) ───────────

MSG_TRUNC = 300
# recentMessages: the last few chat messages (transcript tail) kept per
# session, oldest -> newest, with a larger per-message truncation. 3000 chars
# lets the banner's click-to-expand show essentially whole messages (600 was
# ~7 lines at 12px); 6 msgs x 3KB x hundreds of sessions keeps /summary at a
# few MB worst case, fine for a local endpoint.
RECENT_MSGS = 6
RECENT_TRUNC = 3000
# "initial_user_message" is deliberately NOT a lastHumanMessage source: it is
# by definition the session's FIRST message, so it only serves as a fallback
# when no real user_message was ever captured (see _note_message).
HUMAN_MSG_TYPES = {"user_message"}
INITIAL_HUMAN_TYPE = "initial_user_message"
AGENT_MSG_TYPES = {"devin_message"}

# A user message captured on its way OUT (WS send frame / send POST body) is
# folded immediately with the CAPTURE time; the same message arrives again
# seconds later with the SERVER time (WS echo, v2sessions). Two messages with
# the same role and normalized text within this window are the same message.
NEAR_DUP_S = 300

# Trim sub-microsecond precision (WS events carry nanoseconds) so
# datetime.fromisoformat can parse the timestamp.
_FRAC = re.compile(r"(\.\d{6})\d+")
# Capture timestamps use %z ("-0700"); fromisoformat before 3.11 needs a colon.
_TZ_NOCOLON = re.compile(r"([+-]\d{2})(\d{2})$")
# Session id embedded in an api URL (WS /api/events/devin-<id>/live, ...).
_URL_DEVIN_ID = re.compile(r"devin-([0-9a-f]{8,})")
# Candidate send-message REST paths (none observed yet -- chat goes over the
# WS -- but parsed defensively in case the app grows/changes one).
_SEND_POST_PATH = re.compile(r"/api/.*(message|send|chat)", re.I)
_SESSION_API = re.compile(r"/api/sessions/devin-([0-9a-f]+)(/prs)?$")
# Per-session billing usage (see module docstring for the payload shape).
_BILLING_API = re.compile(r"/api/billing/usage/session/devin-([0-9a-f]+)$")
# v2sessions bodies are truncated at 24KB by the extension, so only the
# leading 1-2 session objects survive JSON decoding -- but the truncated TAIL
# still names every session. These regexes sweep the raw body for
# (devin_id, status) pairs and each object's latest_status_contents (a flat
# object), which is what the awaiting derivation needs. The tempered
# (?!"devin_id") guard keeps a match from spilling into the next session
# object when a field is missing.
_V2_SID_STATUS = re.compile(
    r'"devin_id":\s*"devin-([0-9a-f]+)",\s*"status":\s*"(\w+)"')
_V2_SID_STATUS_CONTENTS = re.compile(
    r'"devin_id":\s*"devin-([0-9a-f]+)"'
    r'(?:(?!"devin_id":)[\s\S]){0,30000}?'
    r'"latest_status_contents":\s*(\{(?:[^{}"]|"(?:[^"\\]|\\.)*")*\})')
# /prs bodies are truncated at 24KB by the extension, so they can't be
# json.loads'd; the leading fields of each item are extracted with a regex.
_PR_ITEM = re.compile(
    r'"pr_url"\s*:\s*"([^"]+)"\s*,\s*"state"\s*:\s*"(\w+)"\s*,\s*"draft"\s*:\s*(true|false)'
)


def _epoch(ts):
    if not ts or not isinstance(ts, str):
        return 0.0
    try:
        return datetime.fromisoformat(
            _TZ_NOCOLON.sub(r"\1:\2", _FRAC.sub(r"\1", ts.replace("Z", "+00:00")))
        ).timestamp()
    except ValueError:
        return 0.0


def _trunc_msg(text, limit=MSG_TRUNC):
    text = " ".join(str(text).split())
    return text[:limit] + ("…" if len(text) > limit else "")


def _norm_text(text):
    """Normalized comparison key for near-duplicate message detection."""
    return " ".join(str(text or "").split()).casefold()[:500]


def _summary_for(sid):
    summ = STATE["summary"].setdefault(sid, {
        "title": None, "rawTitle": None, "status": None,
        "prs": [], "prsAt": None,
        "statusEnum": None, "statusEnumAt": None, "statusMessage": None,
        "awaiting": False,
        "lastHumanMessage": None, "lastHumanMessageAt": None,
        "lastAgentMessage": None, "lastAgentMessageAt": None,
        "recentMessages": [],
        "lastSeen": None,
        "costUsd": None, "acuUsed": None, "costAt": None,
        "decidedTitle": None, "symbol": None, "symbolShortcode": None,
        "decidedAt": None,
    })
    # Entries loaded from latest.json may predate newer fields.
    summ.setdefault("recentMessages", [])
    for k in ("statusEnum", "statusEnumAt", "statusMessage", "rawTitle",
              "costUsd", "acuUsed", "costAt", "prsAt",
              "decidedTitle", "symbol", "symbolShortcode", "decidedAt"):
        summ.setdefault(k, None)
    summ.setdefault("awaiting", False)
    return summ


def _sid_from_devin_id(devin_id):
    if not isinstance(devin_id, str):
        return None
    if devin_id.startswith("devin-"):
        devin_id = devin_id[len("devin-"):]
    return _safe_session_id(devin_id)


def _note_message(summ, contents, approx=False):
    """Record a chat message if it's newer (max message timestamp wins).

    Only full chat messages count: user_message (human) and devin_message
    (agent). Reasoning/tool event types (devin_thoughts, one_line_thoughts,
    thought_summary, shell_*, terminal_update, mcp_*, ...) are excluded, as
    are streaming partials (ops-frames carry no "message").

    Selection is strictly by the message's OWN timestamp -- never the capture
    time: v2sessions re-sends old contents on every poll, so stamping them
    with capture time made the FIRST user message look perpetually newest.
    A message without a timestamp only fills an empty slot (epoch 0).

    approx=True marks a message stamped with CAPTURE time (an outgoing send
    seen before the server assigned a timestamp); when the same message later
    arrives with a server timestamp, the server time replaces the estimate
    (see _note_recent's near-duplicate guard).

    initial_user_message is handled apart: it is the session's first message,
    used only as a fallback while no real user_message has been captured.
    """
    if not isinstance(contents, dict):
        return
    text = contents.get("message")
    if not isinstance(text, str) or not text.strip():
        return
    mtype = contents.get("type")
    if mtype == INITIAL_HUMAN_TYPE:
        if summ["lastHumanMessage"] is None:
            summ["lastHumanMessage"] = _trunc_msg(text)
            summ["lastHumanMessageAt"] = contents.get("timestamp")
        return
    if mtype in HUMAN_MSG_TYPES:
        key, role = "lastHumanMessage", "human"
    elif mtype in AGENT_MSG_TYPES:
        key, role = "lastAgentMessage", "agent"
    else:
        return
    ts = contents.get("timestamp")
    _note_recent(summ, role, text, ts, approx=approx)
    prev_at = summ.get(key + "At")
    if _epoch(ts) >= _epoch(prev_at):
        summ[key] = _trunc_msg(text)
        summ[key + "At"] = ts
    elif (_norm_text(summ.get(key)) == _norm_text(_trunc_msg(text))
          and abs(_epoch(ts) - _epoch(prev_at)) <= NEAR_DUP_S):
        # Same message re-arriving with a slightly EARLIER (server) timestamp
        # than the capture-time estimate we stored: adopt the authoritative ts.
        summ[key + "At"] = ts


def _note_recent(summ, role, text, ts, approx=False):
    """Keep the last RECENT_MSGS chat messages, oldest -> newest.

    Deduped by (role, ts), plus a near-duplicate guard: an outgoing send is
    folded immediately with the CAPTURE time (approx=True), and the same
    message re-arrives seconds later with the SERVER time (WS echo,
    v2sessions) -- same role + same normalized text within NEAR_DUP_S
    collapses to one entry, and the server timestamp replaces the estimate.
    A re-arrival may carry a longer final text, so it replaces the stored
    one. Untimestamped messages are skipped -- they can't be ordered into a
    transcript.
    """
    if not ts:
        return
    recent = summ["recentMessages"]
    norm = _norm_text(text)
    for m in recent:
        if m["role"] != role:
            continue
        if m["ts"] == ts or (norm and _norm_text(m["text"]) == norm
                             and abs(_epoch(m["ts"]) - _epoch(ts)) <= NEAR_DUP_S):
            if m.get("approx") and not approx:
                m["ts"] = ts  # authoritative server time replaces the estimate
                m.pop("approx", None)
                recent.sort(key=lambda x: _epoch(x["ts"]))
            m["text"] = _trunc_msg(text, RECENT_TRUNC)
            return
    entry = {"role": role, "text": _trunc_msg(text, RECENT_TRUNC), "ts": ts}
    if approx:
        entry["approx"] = True
    recent.append(entry)
    recent.sort(key=lambda m: _epoch(m["ts"]))
    del recent[:-RECENT_MSGS]
    _ensure_human_recent(summ)


def _ensure_human_recent(summ):
    """Guarantee the latest HUMAN message is represented in recentMessages.

    Long agent monologues (tool loops, multi-part answers) can push every
    human turn out of the last-RECENT_MSGS window, leaving the banner
    transcript with no trace of what the user asked. When that happens,
    replace the OLDEST retained message with the session's latest human
    message (tracked separately as lastHumanMessage/-At) and re-sort, so the
    list stays chronological. Skipped when the human message has no
    timestamp (can't be ordered) or the window isn't full yet (the human
    message would have been retained if it were among the last few anyway).
    """
    recent = summ["recentMessages"]
    if any(m["role"] == "human" for m in recent):
        return
    text, ts = summ.get("lastHumanMessage"), summ.get("lastHumanMessageAt")
    if not text or not ts or len(recent) < RECENT_MSGS:
        return
    del recent[0]
    recent.append({"role": "human", "text": text, "ts": ts})
    recent.sort(key=lambda m: _epoch(m["ts"]))


def _note_immediate_human(record, text, url):
    """Fold a just-captured OUTGOING chat message as this session's human turn.

    Stamped with the envelope's capture time (the server hasn't assigned one
    yet); marked approx so the server-timestamped copy arriving moments later
    (WS echo, v2sessions) replaces the estimate instead of duplicating. The
    session id comes from the request URL (devin-<id>), falling back to the
    capturing tab's session.
    """
    if not isinstance(text, str) or not text.strip():
        return
    m = _URL_DEVIN_ID.search(url or "")
    sid = _safe_session_id(m.group(1)) if m \
        else _safe_session_id(record.get("sessionId"))
    if not sid:
        return
    ts = record.get("ts")
    summ = _summary_for(sid)
    summ["lastSeen"] = ts
    _note_message(summ, {"type": "user_message", "message": text,
                         "timestamp": ts}, approx=True)


def _derive_awaiting(summ):
    """awaiting = needs the user: blocked on a response, or asleep.

    Mapping derived by cross-validating captured statuses against the old
    text-based detection (see module docstring). "blocked" comes from
    status_update events ("Waiting for your response"); "suspended" covers
    sleep from user inactivity and crashes ("Devin went to sleep").
    """
    summ["awaiting"] = (summ.get("statusEnum") == "blocked"
                        or summ.get("status") == "suspended")


def _note_status(summ, enum, message, ts):
    """Record a status_update if it's newer (by its own timestamp).

    Sources re-send old contents (v2sessions polls carry
    latest_status_contents on every poll), so newest-timestamp-wins, same as
    _note_message. An untimestamped update only fills an empty slot.
    """
    if not enum:
        return
    if _epoch(ts) >= _epoch(summ.get("statusEnumAt")):
        summ["statusEnum"] = enum
        summ["statusEnumAt"] = ts
        summ["statusMessage"] = _trunc_msg(message, 120) if message else None
    _derive_awaiting(summ)


def _note_cost(summ, obj, ts):
    """Fold a per-session billing snapshot (newest capture wins).

    Field choice (documented from captured /api/billing/usage/session/<id>
    bodies): overage_dollars is the session's billed dollar usage -> costUsd;
    acu_used has been 0 in every observed capture (plans here bill overage
    dollars, not ACUs), so acuUsed is only stored when positive. Ordering is
    by capture time (billing responses carry no timestamp of their own).
    """
    dollars = obj.get("overage_dollars")
    acu = obj.get("acu_used")
    if not isinstance(dollars, (int, float)) \
            and not isinstance(acu, (int, float)):
        return
    if _epoch(ts) < _epoch(summ.get("costAt")):
        return
    if isinstance(dollars, (int, float)):
        summ["costUsd"] = round(float(dollars), 2)
    if isinstance(acu, (int, float)) and acu > 0:
        summ["acuUsed"] = round(float(acu), 2)
    summ["costAt"] = ts


def _note_pr(summ, url, state=None, draft=None, merged=None, ts=None):
    """Upsert one PR observation, newest capture wins (keyed by url).

    PR payloads carry no timestamp of their own, so ordering is by capture
    time (observedAt). Guarding on it matters twice: a laggy/cached tab can
    deliver an OLDER v2sessions body after the fresh designated-tab poll,
    and the boot backfill re-folds up to an hour of retained captures over
    the fresher persisted summary -- with plain last-write-wins either one
    regressed "merged" back to "open". An untimestamped observation only
    fills a slot that never saw a timestamped one (epoch 0 vs 0).
    """
    if not url:
        return
    for pr in summ["prs"]:
        if pr["url"] == url:
            break
    else:
        num = re.search(r"/pull/(\d+)", url)
        pr = {"number": int(num.group(1)) if num else None, "title": None,
              "url": url, "state": None, "merged": False, "draft": False,
              "observedAt": None}
        summ["prs"].append(pr)
    if _epoch(ts) < _epoch(pr.get("observedAt")):
        return
    pr["observedAt"] = ts or pr.get("observedAt")
    if state is not None:
        pr["state"] = state
        pr["merged"] = (state == "merged") if merged is None else bool(merged)
    elif merged is not None:
        pr["merged"] = bool(merged)
    if draft is not None:
        pr["draft"] = bool(draft)


def _set_prs(summ, prs_list, ts):
    """Adopt a fully-decoded pull_requests list as the session's PR set.

    A complete session row (full or leading-item-decoded v2sessions, the
    single-session detail endpoint) carries the session's ENTIRE current PR
    list, so it authoritatively REPLACES the summary's set: PRs Devin no
    longer lists (closed-and-detached, moved) are dropped instead of
    lingering as stale "open" forever. Only called with a list that came out
    of json-decoding a complete object -- truncated regex sweeps must keep
    going through _note_pr upserts so a partial view never wipes the set.
    Skipped when a newer replacement (prsAt) already happened, so the boot
    backfill / a laggy tab can't shrink or regress the set.
    """
    if not isinstance(prs_list, list):
        return
    if _epoch(ts) < _epoch(summ.get("prsAt")):
        return
    keep = {pr.get("pr_url") for pr in prs_list if isinstance(pr, dict)}
    summ["prs"] = [pr for pr in summ["prs"] if pr["url"] in keep]
    for pr in prs_list:
        if isinstance(pr, dict):
            _note_pr(summ, pr.get("pr_url"),
                     state=pr.get("state"), draft=pr.get("draft"), ts=ts)
    summ["prsAt"] = ts


_DECODER = json.JSONDecoder()


def _iter_truncated_array(body, prefix):
    """Yield complete JSON objects from a possibly-truncated `prefix[{...},...`.

    The extension truncates net bodies at 24KB, so large v2sessions //stream
    responses fail json.loads; decoding item by item still recovers every
    complete leading element.
    """
    if not body.startswith(prefix):
        return
    i = len(prefix)
    while True:
        try:
            obj, i = _DECODER.raw_decode(body, i)
        except ValueError:
            return
        if isinstance(obj, dict):
            yield obj
        while i < len(body) and body[i] in ", \t\r\n":
            i += 1
        if i >= len(body) or body[i] == "]":
            return


def _fold_session_obj(obj, ts):
    """Fold one session object from v2sessions / session-detail payloads."""
    sid = _sid_from_devin_id(obj.get("devin_id"))
    if not sid:
        return
    summ = _summary_for(sid)
    summ["lastSeen"] = ts
    if obj.get("title"):
        summ["title"] = obj["title"]
        summ["rawTitle"] = obj["title"]
    if obj.get("status"):
        summ["status"] = obj["status"]
        _derive_awaiting(summ)
    lsc = obj.get("latest_status_contents")
    if isinstance(lsc, dict):
        _note_status(summ, lsc.get("enum"), lsc.get("message"),
                     lsc.get("timestamp") or obj.get("latest_status_event_at"))
    # A decoded row's pull_requests is the session's full current PR list ->
    # authoritative set replacement. Some v2sessions variants (e.g.
    # group_children single-session lookups) omit the field entirely; that
    # is "no information", not "no PRs", and _set_prs ignores non-lists.
    _set_prs(summ, obj.get("pull_requests"), ts)
    _note_message(summ, obj.get("initial_user_message_contents"))
    _note_message(summ, obj.get("latest_message_contents"))


def _sweep_v2_statuses(body, ts):
    """Recover (status, latest_status_contents) from a truncated v2sessions
    body for EVERY session named in it, not just the 1-2 leading objects that
    survive JSON decoding. Idempotent with the decoded path."""
    for m in _V2_SID_STATUS.finditer(body):
        sid = _safe_session_id(m.group(1))
        if not sid:
            continue
        summ = _summary_for(sid)
        summ["lastSeen"] = ts
        summ["status"] = m.group(2)
        _derive_awaiting(summ)
    for m in _V2_SID_STATUS_CONTENTS.finditer(body):
        sid = _safe_session_id(m.group(1))
        if not sid:
            continue
        try:
            lsc = json.loads(m.group(2))
        except ValueError:
            continue
        _note_status(_summary_for(sid), lsc.get("enum"), lsc.get("message"),
                     lsc.get("timestamp"))


def _fold_net(record):
    """Fold one captured net envelope into the per-session summary."""
    d = record.get("data")
    if not isinstance(d, dict):
        return
    body = d.get("body")
    if not isinstance(body, str) or not body:
        return
    ts = record.get("ts")

    if d.get("channel") == "ws":
        try:
            frame = json.loads(body)
        except ValueError:
            return
        if not isinstance(frame, dict):
            return
        # OUTGOING send frame: the user's chat message on its way to the
        # server ({"type":"user_message","message":...,"origin":"web",...}).
        # Fold it immediately, stamped with capture time, so the banner shows
        # the human turn without waiting for the server echo / v2sessions
        # poll (which is where the 5-minute lag came from). The echo arriving
        # seconds later with the server timestamp collapses into this entry
        # via the near-duplicate guard.
        if d.get("event") == "send":
            if frame.get("type") == "user_message":
                _note_immediate_human(record, frame.get("message"),
                                      d.get("url"))
            return
        if frame.get("type") != "devin_event":
            return
        sid = _sid_from_devin_id(frame.get("devin_id"))
        ev = frame.get("event")
        if sid and isinstance(ev, dict):
            summ = _summary_for(sid)
            summ["lastSeen"] = ts
            if ev.get("type") == "status_update":
                _note_status(summ, ev.get("enum"), ev.get("message"),
                             ev.get("timestamp"))
            else:
                _note_message(summ, ev)
        return

    # OUTGOING request bodies captured by inject.js (channel "request").
    # No REST send-message endpoint has been observed (the web app sends chat
    # over the live WS), but if one appears -- or the app changes -- parse it
    # defensively: a POST to a message/send/chat-ish api path whose JSON body
    # carries the message text becomes an immediate human message.
    if d.get("channel") == "request":
        if (d.get("method") or "").upper() != "POST":
            return
        url_path = (d.get("url") or "").split("?")[0]
        if not _SEND_POST_PATH.search(url_path):
            return
        text = None
        try:
            b = json.loads(body)
        except ValueError:
            b = None
        if isinstance(b, dict):
            for k in ("message", "text", "content", "prompt"):
                v = b.get(k)
                if isinstance(v, str) and v.strip():
                    text = v
                    break
        if text is None:
            _log("request: unparsed send POST %s (body %r)"
                 % (url_path[:160], body[:120]))
            return
        _note_immediate_human(record, text, d.get("url"))
        return

    url = (d.get("url") or "").split("?")[0]

    # Per-session billing usage: small JSON body, never truncated.
    bm = _BILLING_API.search(url)
    if bm:
        sid = _safe_session_id(bm.group(1))
        if not sid:
            return
        try:
            b = json.loads(body)
        except ValueError:
            return
        if isinstance(b, dict):
            summ = _summary_for(sid)
            summ["lastSeen"] = ts
            _note_cost(summ, b, ts)
        return

    if url.endswith("/v2sessions"):
        try:
            b = json.loads(body)
            items = (b.get("result") or []) if isinstance(b, dict) else []
        except ValueError:  # truncated body: recover the complete lead items
            items = _iter_truncated_array(body, '{"result":[')
        for obj in items:
            if isinstance(obj, dict):
                _fold_session_obj(obj, ts)
        _sweep_v2_statuses(body, ts)
        return

    # Message-history endpoint: /api/events/devin-<id>/stream returns
    # {"result":[{event}...]} with the same event types as the live WS.
    em = re.search(r"/api/events/devin-([0-9a-f]+)/stream$", url)
    if em:
        sid = _safe_session_id(em.group(1))
        if not sid:
            return
        summ = _summary_for(sid)
        summ["lastSeen"] = ts
        for ev in _iter_truncated_array(body, '{"result":['):
            _note_message(summ, ev)
        return

    m = _SESSION_API.search(url)
    if not m:
        return
    if m.group(2):  # /prs endpoint
        sid = _safe_session_id(m.group(1))
        if not sid:
            return
        summ = _summary_for(sid)
        summ["lastSeen"] = ts
        try:  # a body that decodes whole is the full authoritative PR list
            items = json.loads(body)
        except ValueError:
            items = None
        if isinstance(items, list):
            _set_prs(summ, items, ts)
            for pr in items:
                if isinstance(pr, dict) \
                        and isinstance(pr.get("github_pr_data"), dict):
                    _note_pr(summ, pr.get("pr_url"),
                             merged=pr["github_pr_data"].get("merged"),
                             ts=ts)
        else:  # truncated (24KB cutoff): PARTIAL regex sweep -- upsert the
            # leading items only, never treat it as the full set.
            for pm in _PR_ITEM.finditer(body):
                _note_pr(summ, pm.group(1), state=pm.group(2),
                         draft=pm.group(3) == "true", ts=ts)
    else:  # single-session detail
        try:
            b = json.loads(body)
        except ValueError:
            return
        if isinstance(b, dict) and b.get("devin_id"):
            _fold_session_obj(b, ts)


def _backfill_summary():
    """Rebuild the summary from the retained event logs at startup.

    Idempotent (newest-timestamp-wins), so re-folding on every boot is safe
    and keeps the summary consistent with the current parse rules.
    """
    for path in (LOG_FILE + ".old", LOG_FILE):
        try:
            f = open(path)
        except OSError:
            continue
        with f:
            for line in f:
                try:
                    record = json.loads(line)
                except (ValueError, json.JSONDecodeError):
                    continue
                if isinstance(record, dict) and record.get("kind") == "net":
                    _fold_net(record)


# ── LLM enrichment (symbol + decided title per session) ─────────────────────
# A background thread periodically asks OpenAI to pick a distinctive emoji
# (by shortcode, validated against EMOJI_SHORTCODES) and a punchier display
# title for each session, from the raw title + transcript tail. Decisions are
# cached persistently keyed by session id + raw-title hash, so restarts never
# re-bill and a title change triggers exactly one new decision.

LLM_MODEL = "gpt-5.5-mini"
LLM_API_URL = "https://api.openai.com/v1/chat/completions"
LLM_CYCLE_S = 60
LLM_MAX_CALLS_PER_CYCLE = 5
LLM_TITLE_MAX = 60
LLM_TIMEOUT_S = 45
LLM_CACHE_FILE = os.path.join(STATE_DIR, "llm_decisions.json")
LLM_CACHE_MAX = 2000
LLM_KEY_FILE = os.path.expanduser("~/.config/devin-stream/openai_key")
LLM_RC_FILES = ("~/.zshrc", "~/.zshenv", "~/.zprofile",
                "~/.bashrc", "~/.bash_profile", "~/.profile")
_RC_KEY_RE = re.compile(
    r'^\s*(?:export\s+)?OPENAI_API_KEY=["\']?([A-Za-z0-9_-]+)["\']?\s*$')

