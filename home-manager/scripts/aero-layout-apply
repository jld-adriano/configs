#!/usr/bin/env python3
"""Reapply a saved window layout (aero-layout-apply), best-effort.

Presents a native list picker (navigable with the arrow keys) of the saved
states archived by aero-layout-lock, then reapplies the chosen one. Windows
present in the snapshot are returned to their saved workspace, matched first by
window-id (exact within a session) and then by normalized window title
(survives app restarts where ids change). Windows that aren't in the snapshot
are handed to aero-organize, which places them by app/URL while treating the
matched windows as pinned to their saved workspaces.
"""

import json
import os
import re
import subprocess
import time
from collections import defaultdict, deque

CACHE = os.path.expanduser("~/.cache/aerospace-layout.json")
HISTORY_DIR = os.path.expanduser("~/.local/state/aerospace/history")
LOG_FILE = os.path.expanduser("~/.local/state/aerospace/lock-log.tsv")
ORGANIZE = os.path.expanduser(
    "~/projs/configs/home-manager/scripts/aero-organize")


def run(cmd):
    return subprocess.run(
        cmd, shell=True, capture_output=True, text=True, timeout=30
    ).stdout.strip()


def notify(msg):
    try:
        subprocess.run(
            ["osascript", "-e",
             f'display notification "{msg}" with title "AeroSpace Layout"'],
            timeout=10,
        )
    except Exception:
        pass


def done_dialog(msg, title="AeroSpace Layout"):
    """Show a completion modal (auto-dismisses after 20s so it never blocks)."""
    safe = msg.replace("\\", "\\\\").replace('"', '\\"')
    script = (
        'tell application "System Events" to display dialog '
        f'"{safe}" with title "{title}" buttons {{"OK"}} '
        'default button "OK" giving up after 20'
    )
    try:
        subprocess.run(["osascript", "-e", script], timeout=30)
    except Exception:
        pass


# ── State selection ─────────────────────────────────────────────────────────

STAMP_RE = re.compile(r"^(?:(?P<label>.+)-)?"
                      r"(?P<stamp>\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2})$")


def parse_name(name):
    """Split a history filename into (label, stamp-or-remainder).

    layout-2026-06-26_09-26-17.json      -> ("", "2026-06-26_09-26-17")
    layout-auto-2026-07-08_17-09-01.json -> ("auto", "2026-07-08_17-09-01")
    """
    base = name
    if base.startswith("layout-"):
        base = base[len("layout-"):]
    if base.endswith(".json"):
        base = base[:-len(".json")]
    m = STAMP_RE.match(base)
    if m:
        return (m.group("label") or "", m.group("stamp"))
    return ("", base)


def pretty_ts(name):
    """layout-[label-]2026-06-26_09-26-17.json -> 2026-06-26 09:26:17"""
    _label, base = parse_name(name)
    try:
        date, t = base.split("_")
        return f"{date} {t.replace('-', ':')}"
    except ValueError:
        return base


def load_state_index():
    """Return [(name, label, path)] for archived states, most recent first."""
    if not os.path.isdir(HISTORY_DIR):
        return []

    log_rows = {}
    if os.path.exists(LOG_FILE):
        with open(LOG_FILE) as f:
            for line in f.read().splitlines()[1:]:  # skip header
                cols = line.split("\t")
                if len(cols) >= 5:
                    log_rows[cols[4]] = {"nwin": cols[1], "apps": cols[3]}

    # Sort by the embedded timestamp (not the raw filename) so labelled
    # snapshots like layout-auto-<stamp>.json interleave correctly with
    # unlabelled layout-<stamp>.json ones, most recent first.
    files = sorted(
        (f for f in os.listdir(HISTORY_DIR)
         if f.startswith("layout-") and f.endswith(".json")),
        key=lambda f: parse_name(f)[1],
        reverse=True,
    )

    states = []
    for name in files:
        path = os.path.join(HISTORY_DIR, name)
        meta = log_rows.get(name)
        if meta:
            nwin, apps = meta["nwin"], meta["apps"]
        else:
            try:
                with open(path) as f:
                    d = json.load(f)
                ws = d.get("windows", [])
                nwin = str(len(ws))
                counts = {}
                for w in ws:
                    counts[w["app"]] = counts.get(w["app"], 0) + 1
                apps = ", ".join(f"{a}={n}" for a, n in
                                 sorted(counts.items(), key=lambda kv: -kv[1]))
            except Exception:
                nwin, apps = "?", ""
        if len(apps) > 60:
            apps = apps[:57] + "..."
        tag, _stamp = parse_name(name)
        prefix = f"[{tag}] " if tag else ""
        label = f"{prefix}{pretty_ts(name)}  ·  {nwin} win  ·  {apps}"
        states.append((name, label, path))
    return states


def pick_state(states):
    """Show a native arrow-key list picker; return the chosen snapshot path."""
    labels = [s[1] for s in states]
    # Wrap in System Events + activate so the picker pops to the foreground
    # focused, instead of opening behind the current window.
    script = (
        'on run argv\n'
        '  tell application "System Events"\n'
        '    activate\n'
        '    set choice to choose from list argv '
        'with title "Apply Layout" '
        'with prompt "Select a saved state to reapply:" '
        'default items {item 1 of argv} '
        'OK button name "Apply" cancel button name "Cancel"\n'
        '  end tell\n'
        '  if choice is false then\n'
        '    return "###CANCEL###"\n'
        '  else\n'
        '    return item 1 of choice\n'
        '  end if\n'
        'end run'
    )
    res = subprocess.run(
        ["osascript", "-e", script] + labels,
        capture_output=True, text=True, timeout=300,
    ).stdout.strip()

    if not res or res == "###CANCEL###":
        return None
    for _name, label, path in states:
        if label == res:
            return path
    return None


# ── Apply ───────────────────────────────────────────────────────────────────

def normalize(app, title):
    """Strip volatile parts of a title so the same window matches over time."""
    t = title
    t = re.sub(r"\s*[-–]\s*\d+\s+new items?", "", t)       # Slack unread counts
    t = re.sub(r"\s*[-–]\s*High memory usage[^-–]*", "", t)  # Chrome warning
    t = re.sub(r"\s*[-–]\s*Google Chrome.*$", "", t)        # Chrome suffix
    t = t.replace("[Main]", "")                              # Slack main tag
    t = re.sub(r"\s+", " ", t).strip()
    return f"{app}::{t}"


def get_windows():
    windows = []
    fmt = "%{window-id}|%{workspace}|%{app-name}|%{app-bundle-id}|%{window-title}"
    for line in run(f"aerospace list-windows --all --format '{fmt}'").splitlines():
        parts = line.split("|", 4)
        if len(parts) < 5:
            continue
        windows.append({
            "wid": int(parts[0].strip()),
            "ws": int(parts[1].strip()),
            "app": parts[2].strip(),
            "bundle_id": parts[3].strip(),
            "title": parts[4].strip(),
        })
    return windows


def clean_title(title):
    """Reduce a Chrome window title to its active tab title."""
    t = re.sub(r"\s*-\s*Google Chrome.*$", "", title)
    t = re.sub(r"\s*-\s*High memory usage.*$", "", t)
    return t.strip()


CHROME_ACTIVE_APPLESCRIPT = (
    'tell application "Google Chrome"\n'
    '  set out to ""\n'
    '  repeat with w in windows\n'
    '    set t to active tab of w\n'
    '    set tt to ""\n'
    '    try\n'
    '      set tt to title of t\n'
    '    end try\n'
    '    set tu to ""\n'
    '    try\n'
    '      set tu to URL of t\n'
    '    end try\n'
    '    set out to out & tt & "|||" & tu & linefeed\n'
    '  end repeat\n'
    '  return out\n'
    'end tell'
)


def get_current_chrome_urls(current):
    """Map each current Chrome window-id to its active tab URL (for matching)."""
    if "running" not in run("pgrep -x 'Google Chrome' >/dev/null && echo running || true"):
        return {}
    try:
        out = subprocess.run(
            ["osascript", "-e", CHROME_ACTIVE_APPLESCRIPT],
            capture_output=True, text=True, timeout=30,
        ).stdout
    except Exception:
        return {}

    chrome_list = []
    for line in out.split("\n"):
        if "|||" in line:
            title, url = line.split("|||", 1)
            chrome_list.append((title.strip(), url.strip()))

    res = {}
    used = [False] * len(chrome_list)
    for w in current:
        if w["app"] != "Google Chrome":
            continue
        ct = clean_title(w["title"])
        for j, (at, url) in enumerate(chrome_list):
            if used[j] or not at:
                continue
            if at == ct or ct.startswith(at) or at.startswith(ct):
                used[j] = True
                res[w["wid"]] = url
                break
    return res


FOCUSED_X_APPLESCRIPT = (
    'tell application "System Events" to tell '
    '(first process whose frontmost is true) to get value of attribute '
    '"AXPosition" of (value of attribute "AXFocusedWindow")'
)


def focused_window_x():
    """Read the x-coordinate of the currently focused window (via AX)."""
    out = subprocess.run(
        ["osascript", "-e", FOCUSED_X_APPLESCRIPT],
        capture_output=True, text=True, timeout=10,
    ).stdout.strip()
    try:
        return float(out.split(",")[0])
    except (ValueError, IndexError):
        return None


def x_of(wid):
    run(f"aerospace focus --window-id {wid}")
    return focused_window_x()


def reorder_to_snapshot(x_by_wid, pinned):
    """Restore each workspace's left-to-right order to match the snapshot.

    Uses real window x-positions as ground truth (AeroSpace's list order is
    unreliable for visual position). `x_by_wid` maps each matched CURRENT
    window-id to the x it had in the snapshot (so this works even when ids
    changed after a reboot and matching fell back to URL/title). For each
    multi-window workspace, the target order is the matched windows sorted by
    that saved x. We flatten to horizontal tiles, then bubble each window into
    place with `move left`, re-reading positions once.
    """
    # Desired left-to-right wids per workspace, from saved x positions
    desired_by_ws = {}
    for wid, ws in pinned.items():
        x = x_by_wid.get(wid)
        if x is None:
            continue
        desired_by_ws.setdefault(ws, []).append((wid, x))

    reordered = 0
    for ws, items in desired_by_ws.items():
        target = [wid for wid, _ in sorted(items, key=lambda t: t[1])]
        if len(target) < 2:
            continue

        # flatten to a linear horizontal layout so `move left` is a clean
        # adjacent swap (deterministic), letting us avoid re-reading positions
        run(f"aerospace focus --window-id {target[0]}")
        run("aerospace flatten-workspace-tree")
        run("aerospace layout h_tiles")

        # read current left-to-right order ONCE
        xs = {w: (x_of(w) or 0.0) for w in target}
        cur = sorted(target, key=lambda w: xs[w])
        if cur == target:
            continue  # already correct

        # insertion sort via `move left`: for each target slot, pull the right
        # window left into place (each move left = one adjacent swap)
        for pos, wid in enumerate(target):
            i = cur.index(wid)
            if i <= pos:
                continue
            run(f"aerospace focus --window-id {wid}")
            for _ in range(i - pos):
                run("aerospace move left")
            cur.pop(i)
            cur.insert(pos, wid)
        run("aerospace balance-sizes")
        reordered += 1

    if reordered:
        print(f"  Reordered {reordered} workspace(s) to snapshot order")


# ── Chrome window restore ────────────────────────────────────────────────────

def _as_quote(s):
    """Quote a Python string as an AppleScript string literal."""
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def confirm(msg):
    """Show a native Skip/Reopen dialog; return True if the user picked Reopen."""
    script = (
        'tell application "System Events"\n'
        '  activate\n'
        f'  set r to button returned of (display dialog {_as_quote(msg)} '
        'with title "Restore Chrome Windows" '
        'buttons {"Skip", "Reopen"} default button "Reopen")\n'
        '  return r\n'
        'end tell'
    )
    out = subprocess.run(
        ["osascript", "-e", script],
        capture_output=True, text=True, timeout=300,
    ).stdout.strip()
    return out == "Reopen"


def chrome_window_ids():
    """Set of current AeroSpace window-ids belonging to Google Chrome."""
    ids = set()
    fmt = "%{window-id}|%{app-name}"
    for line in run(f"aerospace list-windows --all --format '{fmt}'").splitlines():
        p = line.split("|", 1)
        if len(p) == 2 and p[1].strip() == "Google Chrome":
            try:
                ids.add(int(p[0].strip()))
            except ValueError:
                pass
    return ids


def create_chrome_window(urls, active_index):
    """Open one Chrome window with the given tab URLs; return its new wid.

    The new window's tabs are (re)created in order: the first URL reuses the
    window's initial tab, the rest are appended. `active_index` (1-based) is the
    tab that ends up focused. We diff AeroSpace's Chrome window-ids before and
    after so we can hand the new window's id back for workspace placement.
    """
    urls = [u for u in urls if u]
    if not urls:
        return None
    before = chrome_window_ids()

    lines = [
        'tell application "Google Chrome"',
        '  activate',
        '  set w to make new window',
        f'  set URL of active tab of w to {_as_quote(urls[0])}',
    ]
    for u in urls[1:]:
        lines.append(
            '  make new tab at end of tabs of w '
            f'with properties {{URL:{_as_quote(u)}}}')
    ai = max(1, min(active_index, len(urls)))
    lines.append(f'  set active tab index of w to {ai}')
    lines.append('end tell')
    subprocess.run(
        ["osascript", "-e", "\n".join(lines)],
        capture_output=True, text=True, timeout=60,
    )

    # Wait for AeroSpace to register the newly created window, then return its id.
    for _ in range(20):
        new = chrome_window_ids() - before
        if new:
            return next(iter(new))
        time.sleep(0.15)
    return None


def restore_missing_chrome(snap_windows, used, pinned, x_by_wid):
    """Recreate snapshot Chrome windows that no longer exist (opt-in).

    A window is "missing" if no current window matched its snapshot entry across
    all matching passes (``used[i]`` is False). After confirmation, each is
    reopened with all its saved tabs and added to ``pinned``/``x_by_wid`` so the
    later aero-organize + reorder steps place and order it like a matched window.
    """
    missing = [e for i, e in enumerate(snap_windows)
               if not used[i] and e["app"] == "Google Chrome"
               and (e.get("chrome") or {}).get("tabs")]
    if not missing:
        return 0
    if not confirm(
            f"{len(missing)} Chrome window(s) from this snapshot aren't open. "
            "Reopen them with all their tabs and place them on their saved "
            "workspaces?"):
        print(f"  Skipped restoring {len(missing)} missing Chrome window(s)")
        return 0

    restored = 0
    for e in missing:
        tabs = e["chrome"]["tabs"]
        active = (e.get("chrome") or {}).get("active_tab") or {}
        active_index = 1
        for idx, t in enumerate(tabs):
            if active.get("url") and t.get("url") == active.get("url"):
                active_index = idx + 1
                break
        newid = create_chrome_window(
            [t.get("url", "") for t in tabs], active_index)
        if newid is None:
            continue
        pinned[newid] = e["ws"]
        x_by_wid[newid] = e.get("x")
        restored += 1

    if restored:
        print(f"  Restored {restored} missing Chrome window(s)")
    return restored


def apply_snapshot(snap, label):
    notify(f"⏳ Applying layout {label}…")
    snap_windows = snap.get("windows", [])
    current = get_windows()

    # Match each current window to a snapshot entry, best-effort, in order of
    # decreasing reliability. window-id is a CGWindowID (only stable within a
    # session); after a reboot/app-restart we fall back to Chrome tab URL, then
    # bundle-id + normalized title.
    used = [False] * len(snap_windows)
    by_id = {}
    for i, e in enumerate(snap_windows):
        by_id.setdefault(e["wid"], i)

    matched = {}  # current window-id -> snapshot entry

    # Pass 1: exact window-id (same session)
    for w in current:
        i = by_id.get(w["wid"])
        if i is not None and not used[i]:
            used[i] = True
            matched[w["wid"]] = snap_windows[i]

    # Pass 2: Chrome active-tab URL (survives reboots; ids change, URLs don't)
    cur_urls = get_current_chrome_urls(current)
    url_pool = defaultdict(deque)
    for i, e in enumerate(snap_windows):
        if used[i] or e["app"] != "Google Chrome":
            continue
        url = ((e.get("chrome") or {}).get("active_tab") or {}).get("url")
        if url:
            url_pool[url].append(i)
    for w in current:
        if w["wid"] in matched or w["app"] != "Google Chrome":
            continue
        url = cur_urls.get(w["wid"])
        if url and url_pool.get(url):
            i = url_pool[url].popleft()
            used[i] = True
            matched[w["wid"]] = snap_windows[i]

    # Pass 3: bundle-id + normalized title (Slack threads, other apps)
    title_pool = defaultdict(deque)
    for i, e in enumerate(snap_windows):
        if used[i]:
            continue
        key = (e.get("bundle_id", ""), normalize(e["app"], e["title"]))
        title_pool[key].append(i)
    for w in current:
        if w["wid"] in matched:
            continue
        key = (w.get("bundle_id", ""), normalize(w["app"], w["title"]))
        if title_pool.get(key):
            i = title_pool[key].popleft()
            used[i] = True
            matched[w["wid"]] = snap_windows[i]

    pinned = {wid: e["ws"] for wid, e in matched.items()}
    x_by_wid = {wid: e.get("x") for wid, e in matched.items()}

    # Optionally reopen Chrome windows that no longer exist (e.g. after a
    # reboot). Recreated windows join `pinned`/`x_by_wid`, so the aero-organize
    # and reorder steps below place and order them alongside the matched ones.
    restored = restore_missing_chrome(snap_windows, used, pinned, x_by_wid)

    leftover = [w for w in current if w["wid"] not in pinned]
    by_id_n = sum(1 for w in current if by_id.get(w["wid"]) is not None
                  and matched.get(w["wid"]) is not None)
    print(f"Applying {label}: matched {len(matched)} "
          f"({by_id_n} by id, {len(matched) - by_id_n} by url/title); "
          f"{restored} restored; {len(leftover)} leftover -> aero-organize")

    # Delegate everything to aero-organize: it pins the matched windows to
    # their saved workspaces and places the leftovers around them.
    env = dict(os.environ)
    env["AERO_PINNED"] = ",".join(f"{wid}:{ws}" for wid, ws in pinned.items())
    subprocess.run([ORGANIZE], env=env, timeout=120)

    # Restore each workspace's saved left-to-right order using real window
    # x-positions (deterministic; see reorder_to_snapshot).
    reorder_to_snapshot(x_by_wid, pinned)

    notify(f"Applied {label}: {len(pinned)} pinned, {restored} reopened, "
           f"{len(leftover)} organized")


def main():
    states = load_state_index()
    if states:
        path = pick_state(states)
        if path is None:
            print("Cancelled")
            return
    elif os.path.exists(CACHE):
        path = CACHE  # no history yet; fall back to the current snapshot
    else:
        print("No saved layout. Run aero-layout-lock (alt-shift-s) first.")
        notify("No saved layout to apply")
        return

    with open(path) as f:
        snap = json.load(f)
    label = pretty_ts(os.path.basename(path))
    apply_snapshot(snap, label)
    done_dialog(f"✅ Applied layout: {label}")


if __name__ == "__main__":
    main()
